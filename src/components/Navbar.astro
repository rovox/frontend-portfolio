---
import ThemeToggle from './ThemeToggle.tsx';
import { CV_VIEW_URL_EN } from '../config';

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/#work', label: 'Work' },
  { href: '/#skills', label: 'Skills' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#education', label: 'Education' },
  // { href: '/blog/', label: 'Blog' }, // Blog disabled — re-enable with blog feature
  { href: '/#contact', label: 'Contact' },
];

function isActive(href: string): boolean {
  // Blog page active on /blog/ and sub-paths like /blogs/...
  if (href === '/blog/') {
    return currentPath === '/blog/' || currentPath.startsWith('/blogs/');
  }
  // Hash links are only active on the homepage (pathname === '/')
  // We can't determine scroll position server-side, so we leave it
  // neutral — only non-hash links get an explicit active state.
  return false;
}
---

<nav class="nav" id="main-nav" aria-label="Main navigation">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="Homepage">DEV_ARCHITECT</a>

    <div class="nav-links" role="list">
      {
        navLinks.map(({ href, label }) => (
          <a
            href={href}
            class={'nav-link' + (isActive(href) ? ' nav-link--active' : '')}
            role="listitem"
            aria-current={isActive(href) ? 'page' : undefined}
          >
            {label}
          </a>
        ))
      }
      <a href={CV_VIEW_URL_EN} target="_blank" rel="noopener noreferrer" class="btn btn-primary nav-resume">Resume</a>
      <ThemeToggle client:only="react" />
    </div>

    <button
      class="nav-toggle"
      id="nav-toggle"
      aria-expanded="false"
      aria-label="Toggle navigation menu"
      aria-controls="nav-overlay"
    >
      <span class="nav-toggle-icon" aria-hidden="true">&#9776;</span>
    </button>
  </div>

  <!-- Mobile overlay -->
  <div class="nav-overlay" id="nav-overlay" aria-hidden="true" aria-label="Navigation menu">
    <div class="nav-overlay-header">
      <a href="/" class="nav-overlay-logo" aria-label="Homepage">DEV_ARCHITECT</a>
      <button class="nav-overlay-close" id="nav-overlay-close" aria-label="Close navigation menu">
        <span aria-hidden="true">&times;</span>
      </button>
    </div>
    <nav class="nav-overlay-content">
      {
        navLinks.map(({ href, label }) => (
          <a
            href={href}
            class={'nav-overlay-link' + (isActive(href) ? ' nav-overlay-link--active' : '')}
          >
            {label}
          </a>
        ))
      }
      <a href={CV_VIEW_URL_EN} target="_blank" rel="noopener noreferrer" class="btn btn-primary nav-resume-mobile">Resume</a>
      <ThemeToggle client:only="react" />
    </nav>
  </div>
</nav>

<script>
  import { defineModule } from '../utils/lifecycle';

  defineModule('navbar', () => {
    const listeners: Array<{
      el: EventTarget;
      type: string;
      fn: EventListenerOrEventListenerObject;
      opts?: AddEventListenerOptions;
    }> = [];

    function on(
      el: EventTarget,
      type: string,
      fn: EventListenerOrEventListenerObject,
      opts?: AddEventListenerOptions,
    ) {
      el.addEventListener(type, fn, opts);
      listeners.push({ el, type, fn, opts });
    }

    function cleanup() {
      listeners.forEach(({ el, type, fn, opts }) => el.removeEventListener(type, fn, opts));
      listeners.length = 0;
    }

    // ── Overlay open/close ──
    function initNavOverlay() {
      const toggle = document.getElementById('nav-toggle')!;
      const overlay = document.getElementById('nav-overlay')!;
      const closeBtn = document.getElementById('nav-overlay-close');
      const overlayLinks = overlay.querySelectorAll('.nav-overlay-link');

      let isOpen = false;

      function open() {
        isOpen = true;
        toggle.setAttribute('aria-expanded', 'true');
        overlay.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        overlay.style.display = 'flex';
        void overlay.offsetHeight;
        overlay.classList.add('nav-overlay--open');
      }

      function close() {
        isOpen = false;
        toggle.setAttribute('aria-expanded', 'false');
        overlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        overlay.classList.remove('nav-overlay--open');
        overlay.addEventListener(
          'transitionend',
          () => {
            if (!isOpen) overlay.style.display = 'none';
          },
          { once: true },
        );
      }

      on(toggle, 'click', () => {
        if (isOpen) close();
        else open();
      });

      if (closeBtn) on(closeBtn, 'click', close);

      overlayLinks.forEach((link) => {
        on(link, 'click', close);
      });

      on(document, 'keydown', ((e: KeyboardEvent) => {
        if (e.key === 'Escape' && isOpen) close();
      }) as EventListener);

      on(
        window,
        'resize',
        () => {
          if (window.innerWidth >= 720 && isOpen) close();
        },
        { passive: true },
      );
    }

    // ── Hash link interception ──
    function handleHashLinkClick(e: Event) {
      const link = e.currentTarget as HTMLAnchorElement;
      const href = link.getAttribute('href');
      if (!href || !href.startsWith('/#')) return;
      if (window.location.pathname !== '/') return;
      e.preventDefault();
      const target = document.querySelector(href.replace('/', ''));
      if (!target) return;
      if ((window as any).lenis) {
        (window as any).lenis.scrollTo(target, { offset: -80 });
      } else {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        window.scrollBy(0, -80);
      }
    }

    document.querySelectorAll('.nav-link[href^="/#"]').forEach((el) => {
      on(el, 'click', handleHashLinkClick);
    });

    document.querySelectorAll('.nav-overlay-link[href^="/#"]').forEach((el) => {
      on(el, 'click', handleHashLinkClick);
    });

    // ── Preloader lifecycle ──
    if ((window as any).__portfolioLoaderDone) {
      initNavOverlay();
    } else {
      const preloaderHandler = () => initNavOverlay();
      on(window, 'preloader:done', preloaderHandler, { once: true });
    }

    return cleanup;
  });
</script>

<style>
  /* ==============================================
     Navbar — Midnight Protocol Glassmorphic Pill
     ============================================== */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(21, 29, 30, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
  }

  [data-theme="light"] .nav {
    background: rgba(255, 255, 255, 0.85);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 2rem;
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
  }

  /* Logo */
  .nav-logo {
    font-family: var(--font-mono);
    font-size: var(--fs-headline-md);
    font-weight: 700;
    color: var(--primary);
    text-decoration: none;
    letter-spacing: 0.02em;
    white-space: nowrap;
    transition: color var(--transition-fast);
  }

  .nav-logo:hover {
    color: var(--primary-container);
  }

  /* Desktop links */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    list-style: none;
  }

  .nav-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--transition-fast);
    white-space: nowrap;
    padding: 0.25rem 0;
  }

  .nav-link:hover {
    color: var(--primary-container);
  }

  /* Active link — leading `>` in monospaced font */
  .nav-link--active {
    color: var(--primary);
  }

  .nav-link--active::before {
    content: '> ';
    color: var(--primary-container);
  }

  /* Resume button */
  .nav-resume {
    margin-left: 0.5rem;
    font-size: var(--fs-label);
    padding: 0.45rem 1rem;
  }

  /* ==============================================
     Mobile hamburger
     ============================================== */
  .nav-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem;
    color: var(--muted);
    transition: color var(--transition-fast);
  }

  .nav-toggle:hover {
    color: var(--primary-container);
  }

  .nav-toggle-icon {
    font-size: 1.5rem;
    line-height: 1;
  }

  /* ==============================================
     Mobile overlay
     ============================================== */
  .nav-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 2000;
    background: rgba(13, 21, 21, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: translateY(-10px);
    transition: opacity var(--transition-normal), transform var(--transition-normal);
  }

  [data-theme="light"] .nav-overlay {
    background: rgba(250, 246, 241, 0.95);
  }

  .nav-overlay--open {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-overlay {
      transition: none;
    }
  }

  .nav-overlay-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
  }

  .nav-overlay-logo {
    font-family: var(--font-mono);
    font-size: var(--fs-headline-md);
    font-weight: 700;
    color: var(--primary);
    text-decoration: none;
  }

  .nav-overlay-close {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem 0.5rem;
    color: var(--muted);
    font-size: 2rem;
    line-height: 1;
    transition: color var(--transition-fast);
  }

  .nav-overlay-close:hover {
    color: var(--primary-container);
  }

  .nav-overlay-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .nav-overlay-link {
    font-family: var(--font-mono);
    font-size: var(--fs-headline-md);
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .nav-overlay-link:hover {
    color: var(--primary-container);
  }

  .nav-overlay-link--active {
    color: var(--primary);
  }

  .nav-overlay-link--active::before {
    content: '> ';
    color: var(--primary-container);
  }

  .nav-resume-mobile {
    margin-top: 0.5rem;
    font-size: var(--fs-body-md);
    padding: 0.65rem 1.5rem;
  }

  /* ==============================================
     Theme toggle button
     ============================================== */
  .theme-toggle {
    background: none;
    border: 1px solid var(--border);
    color: var(--muted);
    padding: 0.45rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: color var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast);
    font-size: 1.1rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .theme-toggle:hover {
    color: var(--primary-container);
    border-color: var(--primary-container);
    background: var(--surface);
  }

  /* ==============================================
     Responsive
     ============================================== */
  @media (max-width: 719px) {
    .nav-inner {
      padding: 1rem 1.25rem;
    }

    .nav-links {
      display: none;
    }

    .nav-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
    }
  }

  @media (min-width: 720px) {
    .nav-overlay {
      display: none !important;
    }
  }
</style>
