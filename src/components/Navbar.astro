---
import ThemeToggle from './ThemeToggle.tsx';
import { CV_VIEW_URL_EN } from '../config';

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/#experience', label: 'Experience' },
  { href: '/#work', label: 'Work' },
  { href: '/#skills', label: 'Skills' },
  { href: '/#education', label: 'Education' },
  // { href: '/blog/', label: 'Blog' }, // Blog disabled — re-enable with blog feature
  { href: '/#contact', label: 'Contact' },
];

function isActive(href: string): boolean {
  // Blog page active on /blog/ and sub-paths like /blogs/...
  if (href === '/blog/') {
    return currentPath === '/blog/' || currentPath.startsWith('/blogs/');
  }
  // Hash links are only active on the homepage (pathname === '/')
  // We can't determine scroll position server-side, so we leave it
  // neutral — only non-hash links get an explicit active state.
  return false;
}
---

<nav class="nav" id="main-nav" aria-label="Main navigation">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="Homepage" title="portfolio rovox.exe">
      <img
        src="https://github.com/rovox.png"
        alt=""
        class="nav-logo-avatar"
        width="32"
        height="32"
        loading="eager"
        decoding="async"
      />
      <span class="nav-logo-wordmark">rovox</span>
    </a>

    <div class="nav-links" role="list">
      {
        navLinks.map(({ href, label }) => (
          <a
            href={href}
            class={'nav-link' + (isActive(href) ? ' nav-link--active' : '')}
            role="listitem"
            aria-current={isActive(href) ? 'page' : undefined}
          >
            {label}
          </a>
        ))
      }
      <a href={CV_VIEW_URL_EN} target="_blank" rel="noopener noreferrer" class="btn btn-primary nav-resume">Resume</a>
      <ThemeToggle client:only="react" />
    </div>

    <button
      class="nav-toggle"
      id="nav-toggle"
      aria-expanded="false"
      aria-label="Toggle navigation menu"
      aria-controls="nav-overlay"
    >
      <span class="nav-toggle-icon" aria-hidden="true">&#9776;</span>
    </button>
  </div>

  <!-- Mobile overlay -->
  <div class="nav-overlay" id="nav-overlay" aria-hidden="true" aria-label="Navigation menu">
    <div class="nav-overlay-header">
      <a href="/" class="nav-overlay-logo" aria-label="Homepage" title="portfolio rovox.exe">
        <img src="https://github.com/rovox.png" alt="" class="nav-logo-avatar nav-logo-avatar--lg" width="36" height="36" loading="eager" decoding="async" />
        <span class="nav-logo-wordmark">rovox</span>
      </a>
      <button class="nav-overlay-close" id="nav-overlay-close" aria-label="Close navigation menu">
        <span aria-hidden="true">&times;</span>
      </button>
    </div>
    <nav class="nav-overlay-content">
      {
        navLinks.map(({ href, label }) => (
          <a
            href={href}
            class={'nav-overlay-link' + (isActive(href) ? ' nav-overlay-link--active' : '')}
          >
            {label}
          </a>
        ))
      }
      <a href={CV_VIEW_URL_EN} target="_blank" rel="noopener noreferrer" class="btn btn-primary nav-resume-mobile">Resume</a>
      <ThemeToggle client:only="react" />
    </nav>
  </div>
</nav>

<script>
  import { defineModule } from '../utils/lifecycle';

  defineModule('navbar', () => {
    const listeners: Array<{
      el: EventTarget;
      type: string;
      fn: EventListenerOrEventListenerObject;
      opts?: AddEventListenerOptions;
    }> = [];

    function on(
      el: EventTarget,
      type: string,
      fn: EventListenerOrEventListenerObject,
      opts?: AddEventListenerOptions,
    ) {
      el.addEventListener(type, fn, opts);
      listeners.push({ el, type, fn, opts });
    }

    function cleanup() {
      listeners.forEach(({ el, type, fn, opts }) => el.removeEventListener(type, fn, opts));
      listeners.length = 0;
    }

    // ── Overlay open/close ──
    function initNavOverlay() {
      const toggle = document.getElementById('nav-toggle')!;
      const overlay = document.getElementById('nav-overlay')!;
      const closeBtn = document.getElementById('nav-overlay-close');
      const overlayLinks = overlay.querySelectorAll('.nav-overlay-link');

      let isOpen = false;

      function open() {
        isOpen = true;
        toggle.setAttribute('aria-expanded', 'true');
        overlay.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        overlay.style.display = 'flex';
        void overlay.offsetHeight;
        overlay.classList.add('nav-overlay--open');
      }

      function close() {
        isOpen = false;
        toggle.setAttribute('aria-expanded', 'false');
        overlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        overlay.classList.remove('nav-overlay--open');
        overlay.addEventListener(
          'transitionend',
          () => {
            if (!isOpen) overlay.style.display = 'none';
          },
          { once: true },
        );
      }

      on(toggle, 'click', () => {
        if (isOpen) close();
        else open();
      });

      if (closeBtn) on(closeBtn, 'click', close);

      overlayLinks.forEach((link) => {
        on(link, 'click', close);
      });

      on(document, 'keydown', ((e: KeyboardEvent) => {
        if (e.key === 'Escape' && isOpen) close();
      }) as EventListener);

      on(
        window,
        'resize',
        () => {
          if (window.innerWidth >= 720 && isOpen) close();
        },
        { passive: true },
      );
    }

    // ── Hash link interception (delegated — covers navbar links + hero CTA) ──
    function handleHashLinkClick(e: Event) {
      const link = (e.target as HTMLElement).closest('a[href^="/#"]') as HTMLAnchorElement | null;
      if (!link) return;
      if (window.location.pathname !== '/') return;
      e.preventDefault();
      const href = link.getAttribute('href');
      if (!href) return;
      const target = document.querySelector(href.replace('/', ''));
      if (!target) return;
      if ((window as any).lenis) {
        (window as any).lenis.scrollTo(target, { offset: -80 });
      } else {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        window.scrollBy(0, -80);
      }
    }

    on(document, 'click', handleHashLinkClick);

    // ── Preloader lifecycle ──
    if ((window as any).__portfolioLoaderDone) {
      initNavOverlay();
    } else {
      const preloaderHandler = () => initNavOverlay();
      on(window, 'preloader:done', preloaderHandler, { once: true });
    }

    return cleanup;
  });
</script>

<style>
  /* ==============================================
     Navbar — Midnight Protocol Glassmorphic Pill
     ============================================== */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(13, 21, 21, 0.78);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    border-bottom: 1px solid rgba(0, 242, 255, 0.14);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.18);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 2rem;
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
    position: relative;
  }

  /* Logo — avatar + wordmark lockup (desktop) */
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--primary);
    flex-shrink: 0;
  }

  .nav-logo-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .nav-logo-avatar--lg {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .nav-logo-wordmark {
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--primary);
  }

  /* Overlay header — absolute bar inside mobile overlay */
  .nav-overlay-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
  }

  .nav-overlay-logo {
    font-family: var(--font-mono);
    font-size: var(--fs-headline-md);
    font-weight: 700;
    color: var(--primary);
    text-decoration: none;
  }

  .nav-overlay-close {
    background: none;
    border: 1px solid rgba(0, 242, 255, 0.12);
    border-radius: var(--radius-md);
    cursor: pointer;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    font-size: 1.5rem;
    line-height: 1;
    transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
    background: rgba(255, 255, 255, 0.02);
  }

  .nav-overlay-close:hover {
    background: #ffffff;
    color: #0d1515;
    border-color: #ffffff;
  }

  .nav-overlay-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    margin-top: 5rem;
  }

  .nav-overlay-link {
    font-family: var(--font-mono);
    font-size: var(--fs-headline-md);
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--transition-fast);
    padding: 0.75rem 0.5rem;
  }

  .nav-overlay-link:hover {
    color: var(--primary-container);
  }

  .nav-overlay-link--active {
    color: var(--primary);
  }

  .nav-overlay-link--active::before {
    content: '> ';
    color: var(--primary-container);
  }

  .nav-resume-mobile {
    margin-top: 0.5rem;
    font-size: var(--fs-body-md);
    padding: 0.65rem 1.5rem;
  }

  /* ==============================================
     Theme toggle button — circular, icon-driven
     ============================================== */
  .theme-toggle {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid rgba(0, 242, 255, 0.08);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    line-height: 1;
    padding: 0;
    flex-shrink: 0;
  }
  [data-theme="dark"] .theme-toggle {
    background: #0d1515;
    color: #FFD700;
    border-color: rgba(255, 215, 0, 0.15);
  }
  [data-theme="dark"] .theme-toggle:hover {
    border-color: #FFD700;
    box-shadow: 0 0 12px rgba(255, 215, 0, 0.2);
  }
  [data-theme="light"] .theme-toggle {
    background: #ffffff;
    color: #1a1a2e;
    border-color: rgba(0, 0, 0, 0.08);
  }
  [data-theme="light"] .theme-toggle:hover {
    border-color: #1a1a2e;
    box-shadow: 0 0 12px rgba(0, 0, 0, 0.08);
  }

  /* ==============================================
     Base: Desktop nav-links, hamburger, overlay
     ============================================== */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: var(--fs-code);
    font-weight: 500;
    color: var(--muted);
    padding: 0.5rem 0.25rem;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--primary-container);
  }

  .nav-link--active {
    color: var(--primary);
  }

  .nav-link--active::before {
    content: '> ';
    color: var(--primary-container);
  }

  .nav-resume {
    padding: 0.5rem 1rem;
    font-size: var(--fs-code);
  }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(0, 242, 255, 0.18);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.02);
    color: var(--muted);
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
  }

  .nav-toggle:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--primary-container);
  }

  .nav-toggle-icon {
    font-size: 1.25rem;
    line-height: 1;
  }

  .nav-overlay {
    position: fixed;
    inset: 0;
    z-index: 999;
    background: rgba(13, 21, 21, 0.96);
    backdrop-filter: blur(22px) saturate(150%);
    -webkit-backdrop-filter: blur(22px) saturate(150%);
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .nav-overlay--open {
    display: flex;
  }

  /* ==============================================
     Responsive
     ============================================== */
  @media (max-width: 719px) {
    .nav-inner {
      padding: 0.75rem 1.25rem;
    }

    .nav-links {
      display: none;
    }

    .nav-toggle {
      display: flex;
    }
  }

  @media (min-width: 720px) {
    .nav-overlay {
      display: none !important;
    }
  }
</style>
