---
// Theme toggle DISABLED — site is dark-mode only. Component kept in repo;
// re-enable the three `<ThemeToggle client:only="react" />` lines below plus
// the theme init logic in Layout.astro to restore light/dark switching.
// import ThemeToggle from './ThemeToggle.tsx';
import { CV_VIEW_URL_EN } from '../config';

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/#experience', label: 'Experience' },
  { href: '/#work', label: 'Work' },
  { href: '/#skills', label: 'Skills' },
  { href: '/#education', label: 'Education' },
  // { href: '/blog/', label: 'Blog' }, // Blog disabled — re-enable with blog feature
  { href: '/#contact', label: 'Contact' },
];

function isActive(href: string): boolean {
  // Blog page active on /blog/ and sub-paths like /blogs/...
  if (href === '/blog/') {
    return currentPath === '/blog/' || currentPath.startsWith('/blogs/');
  }
  // Hash links are only active on the homepage (pathname === '/')
  // We can't determine scroll position server-side, so we leave it
  // neutral — only non-hash links get an explicit active state.
  return false;
}
---

<nav class="nav" id="main-nav" aria-label="Main navigation">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="Homepage" title="portfolio rovox.exe">
      <img
        src="https://github.com/rovox.png"
        alt=""
        class="nav-logo-avatar"
        width="32"
        height="32"
        loading="eager"
        decoding="async"
      />
      <span class="nav-logo-wordmark">rovox</span>
    </a>

    <div class="nav-links" role="list">
      {
        navLinks.map(({ href, label }) => (
          <a
            href={href}
            class={'nav-link' + (isActive(href) ? ' nav-link--active' : '')}
            role="listitem"
            aria-current={isActive(href) ? 'page' : undefined}
          >
            {label}
          </a>
        ))
      }
      <a href={CV_VIEW_URL_EN} target="_blank" rel="noopener noreferrer" class="btn btn-primary nav-resume">Resume</a>
      {/* ThemeToggle disabled — dark mode only */}
      {/* <ThemeToggle client:only="react" /> */}
    </div>

    <button
      class="nav-toggle"
      id="nav-toggle"
      aria-expanded="false"
      aria-label="Toggle navigation menu"
      aria-controls="nav-drawer"
    >
      <span class="nav-toggle-icon" aria-hidden="true">&#9776;</span>
    </button>
  </div>

  <!-- Mobile nav backdrop (dims page below navbar; click to close) -->
  <div class="nav-backdrop" id="nav-backdrop" aria-hidden="true"></div>

  <!-- Mobile drawer — compact right-side panel -->
  <div class="nav-drawer" id="nav-drawer" aria-hidden="true" aria-label="Navigation menu">
    <div class="nav-drawer-header">
      <span class="nav-drawer-title" aria-hidden="true">Menu</span>
      <button class="nav-drawer-close" id="nav-drawer-close" aria-label="Close navigation menu">
        <span aria-hidden="true">&times;</span>
      </button>
    </div>
    <nav class="nav-drawer-content">
      {
        navLinks.map(({ href, label }) => (
          <a
            href={href}
            class={'nav-drawer-link' + (isActive(href) ? ' nav-drawer-link--active' : '')}
          >
            {label}
          </a>
        ))
      }
      <a href={CV_VIEW_URL_EN} target="_blank" rel="noopener noreferrer" class="btn btn-primary nav-resume-mobile">Resume</a>
      {/* ThemeToggle disabled — dark mode only */}
      {/* <ThemeToggle client:only="react" /> */}
    </nav>
  </div>
</nav>

<script>
  import { defineModule } from '../utils/lifecycle';

  defineModule('navbar', () => {
    const listeners: Array<{
      el: EventTarget;
      type: string;
      fn: EventListenerOrEventListenerObject;
      opts?: AddEventListenerOptions;
    }> = [];

    function on(
      el: EventTarget,
      type: string,
      fn: EventListenerOrEventListenerObject,
      opts?: AddEventListenerOptions,
    ) {
      el.addEventListener(type, fn, opts);
      listeners.push({ el, type, fn, opts });
    }

    function cleanup() {
      listeners.forEach(({ el, type, fn, opts }) => el.removeEventListener(type, fn, opts));
      listeners.length = 0;
    }

    // ── Drawer open/close ──
    function initNavDrawer() {
      const toggle = document.getElementById('nav-toggle')!;
      const drawer = document.getElementById('nav-drawer')!;
      const backdrop = document.getElementById('nav-backdrop')!;
      const closeBtn = document.getElementById('nav-drawer-close');
      const drawerLinks = drawer.querySelectorAll('.nav-drawer-link');

      let isOpen = false;
      let focusRestore: HTMLElement | null = null;

      function open() {
        if (isOpen) return;
        isOpen = true;
        focusRestore = document.activeElement as HTMLElement;
        toggle.setAttribute('aria-expanded', 'true');
        drawer.setAttribute('aria-hidden', 'false');
        backdrop.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        drawer.classList.add('nav-drawer--open');
        backdrop.classList.add('nav-backdrop--open');
        closeBtn?.focus();
      }

      function close() {
        if (!isOpen) return;
        isOpen = false;
        toggle.setAttribute('aria-expanded', 'false');
        drawer.setAttribute('aria-hidden', 'true');
        backdrop.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        drawer.classList.remove('nav-drawer--open');
        backdrop.classList.remove('nav-backdrop--open');
        focusRestore?.focus();
        focusRestore = null;
      }

      on(toggle, 'click', () => {
        if (isOpen) close();
        else open();
      });

      on(backdrop, 'click', close);

      if (closeBtn) on(closeBtn, 'click', close);

      drawerLinks.forEach((link) => {
        on(link, 'click', close);
      });

      on(document, 'keydown', ((e: KeyboardEvent) => {
        if (e.key === 'Escape' && isOpen) close();
      }) as EventListener);

      on(
        window,
        'resize',
        () => {
          if (window.innerWidth >= 720 && isOpen) close();
        },
        { passive: true },
      );
    }

    // ── Hash link interception (delegated — covers navbar links + hero CTA) ──
    // Registered in CAPTURE phase: Astro's ClientRouter attaches its own
    // document click listener (bubble phase) BEFORE this script runs, and
    // intercepts every anchor click with preventDefault + navigate(). By
    // handling hash links in the capture phase we run first; our preventDefault
    // makes ClientRouter bail out (it checks `ev.defaultPrevented`), so the
    // Lenis smooth-scroll below is the only navigation that happens.
    function handleHashLinkClick(e: Event) {
      const link = (e.target as HTMLElement).closest('a[href^="/#"]') as HTMLAnchorElement | null;
      if (!link) return;
      if (window.location.pathname !== '/') return;
      e.preventDefault();
      const href = link.getAttribute('href');
      if (!href) return;
      const target = document.querySelector(href.replace('/', ''));
      if (!target) return;
      if ((window as any).lenis) {
        (window as any).lenis.scrollTo(target, { offset: -80 });
      } else {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        window.scrollBy(0, -80);
      }
    }

    on(document, 'click', handleHashLinkClick, { capture: true });

    // ── Scrollspy — active section indicator ──
    const spySections = ['experience', 'work', 'skills', 'education', 'contact'];
    let spyRAF = 0;

    function updateScrollspy() {
      const viewMid = window.innerHeight * 0.4;
      let currentId = spySections[0];

      for (const id of spySections) {
        const el = document.getElementById(id);
        if (!el) continue;
        if (el.getBoundingClientRect().top <= viewMid) {
          currentId = id;
        }
      }

      // Bottom-of-page: last section active
      const scrollBottom = window.innerHeight + window.scrollY;
      if (scrollBottom >= document.documentElement.scrollHeight - 2) {
        currentId = spySections[spySections.length - 1];
      }

      // Desktop nav links
      document.querySelectorAll('.nav-link').forEach((link) => {
        const href = link.getAttribute('href');
        if (href && href.startsWith('/#')) {
          const active = href === `/#${currentId}`;
          link.classList.toggle('nav-link--active', active);
          if (active) link.setAttribute('aria-current', 'page');
          else link.removeAttribute('aria-current');
        }
      });

      // Mobile drawer links
      document.querySelectorAll('.nav-drawer-link').forEach((link) => {
        const href = link.getAttribute('href');
        if (href && href.startsWith('/#')) {
          const active = href === `/#${currentId}`;
          link.classList.toggle('nav-drawer-link--active', active);
        }
      });
    }

    on(
      window,
      'scroll',
      () => {
        if (!spyRAF) {
          spyRAF = requestAnimationFrame(() => {
            spyRAF = 0;
            updateScrollspy();
          });
        }
      },
      { passive: true },
    );

    // ── Preloader lifecycle ──
    function init() {
      initNavDrawer();
      updateScrollspy();
    }

    if ((window as any).__portfolioLoaderDone) {
      init();
    } else {
      const preloaderHandler = () => init();
      on(window, 'preloader:done', preloaderHandler, { once: true });
    }

    return () => {
      if (spyRAF) {
        cancelAnimationFrame(spyRAF);
        spyRAF = 0;
      }
      cleanup();
    };
  });
</script>

<style>
  /* ==============================================
     Navbar — Midnight Protocol Glassmorphic Pill
     ============================================== */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(13, 21, 21, 0.78);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    border-bottom: 1px solid rgba(0, 242, 255, 0.14);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.18);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 2rem;
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
    position: relative;
  }

  /* Logo — avatar + wordmark lockup (desktop) */
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--primary);
    flex-shrink: 0;
  }

  .nav-logo-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .nav-logo-avatar--lg {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .nav-logo-wordmark {
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--primary);
  }

  /* ==============================================
     Mobile drawer — compact right-side panel
     ============================================== */
  .nav-backdrop {
    position: fixed;
    inset: 0;
    z-index: 997;
    background: rgba(0, 0, 0, 0.28);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .nav-backdrop--open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .nav-drawer {
    position: fixed;
    top: 76px;
    right: 1rem;
    width: min(280px, calc(100vw - 2rem));
    max-height: calc(100vh - 92px);
    overflow-y: auto;
    z-index: 998;
    display: flex;
    flex-direction: column;
    background: rgba(13, 21, 21, 0.92);
    backdrop-filter: blur(20px) saturate(150%);
    -webkit-backdrop-filter: blur(20px) saturate(150%);
    border: 1px solid rgba(0, 242, 255, 0.14);
    border-radius: var(--radius-lg);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.4);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateX(110%);
    transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.3s cubic-bezier(0.4, 0, 0.2, 1), transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-drawer--open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(0);
  }

  .nav-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 0.75rem 0.5rem 1.25rem;
    border-bottom: 1px solid rgba(0, 242, 255, 0.08);
  }

  .nav-drawer-title {
    font-family: var(--font-mono);
    font-size: var(--fs-code);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .nav-drawer-close {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(0, 242, 255, 0.12);
    border-radius: var(--radius-md);
    cursor: pointer;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    font-size: 1.5rem;
    line-height: 1;
    transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
  }

  .nav-drawer-close:hover {
    background: #ffffff;
    color: #0d1515;
    border-color: #ffffff;
  }

  .nav-drawer-content {
    display: flex;
    flex-direction: column;
    padding: 0.75rem;
    gap: 0.25rem;
  }

  .nav-drawer-link {
    font-family: var(--font-mono);
    font-size: var(--fs-body-md);
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--transition-fast), background var(--transition-fast), box-shadow var(--transition-fast);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-md);
  }

  .nav-drawer-link::before {
    content: '> ';
    color: var(--primary-container);
    opacity: 0.5;
    font-weight: 700;
  }

  .nav-drawer-link:hover {
    color: var(--primary);
    background: rgba(255, 255, 255, 0.04);
  }

  .nav-drawer-link--active {
    color: var(--primary);
    background: rgba(0, 242, 255, 0.08);
    box-shadow: inset 2px 0 0 var(--primary-container);
  }

  .nav-drawer-link--active::before {
    opacity: 1;
    color: var(--primary-container);
  }

  .nav-resume-mobile {
    margin-top: 0.5rem;
    font-size: var(--fs-body-md);
    padding: 0.65rem 1.5rem;
    align-self: flex-start;
  }

  /* Theme toggle inside drawer — centered, with top spacing */
  .nav-drawer .theme-toggle {
    margin: 0.75rem auto 0.25rem;
  }

  /* ==============================================
     Theme toggle button — circular, icon-driven
     ============================================== */
  .theme-toggle {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid rgba(0, 242, 255, 0.08);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    line-height: 1;
    padding: 0;
    flex-shrink: 0;
  }
  [data-theme="dark"] .theme-toggle {
    background: #0d1515;
    color: #FFD700;
    border-color: rgba(255, 215, 0, 0.15);
  }
  [data-theme="dark"] .theme-toggle:hover {
    border-color: #FFD700;
    box-shadow: 0 0 12px rgba(255, 215, 0, 0.2);
  }
  [data-theme="light"] .theme-toggle {
    background: #ffffff;
    color: #1a1a2e;
    border-color: rgba(0, 0, 0, 0.08);
  }
  [data-theme="light"] .theme-toggle:hover {
    border-color: #1a1a2e;
    box-shadow: 0 0 12px rgba(0, 0, 0, 0.08);
  }

  /* ==============================================
     Base: Desktop nav-links, hamburger, overlay
     ============================================== */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: var(--fs-code);
    font-weight: 500;
    color: var(--muted);
    padding: 0.5rem 0.25rem;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--primary-container);
  }

  .nav-link--active {
    color: var(--primary);
  }

  .nav-link--active::before {
    content: '> ';
    color: var(--primary-container);
  }

  .nav-resume {
    padding: 0.5rem 1rem;
    font-size: var(--fs-code);
  }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(0, 242, 255, 0.18);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.02);
    color: var(--muted);
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
  }

  .nav-toggle:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--primary-container);
  }

  .nav-toggle-icon {
    font-size: 1.25rem;
    line-height: 1;
  }

  /* ==============================================
     Responsive
     ============================================== */
  @media (max-width: 719px) {
    .nav-inner {
      padding: 0.75rem 1.25rem;
    }

    .nav-links {
      display: none;
    }

    .nav-toggle {
      display: flex;
    }
  }

  @media (min-width: 720px) {
    .nav-drawer,
    .nav-backdrop {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-drawer,
    .nav-backdrop {
      transition: none;
    }
  }
</style>
