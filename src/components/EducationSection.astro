---
import { render, type CollectionEntry } from 'astro:content';
import SectionWrapper from './ui/SectionWrapper.astro';

interface Props {
  items: CollectionEntry<'education'>[];
}

const { items } = Astro.props;
const rendered = await Promise.all(
  items.map(async (item) => {
    const { Content } = await render(item);
    return { ...item, Content };
  })
);
---

<SectionWrapper id="education" title="&lt;Education /&gt;" note="// Academic foundations and continuous learning">
  <div class="education-grid">
    {rendered.map((edu) => (
      <article class="glass-card card-glow education-card">
        <h3 class="edu-institution">{edu.data.institution}</h3>
        <p class="edu-degree">{edu.data.degree}</p>
        <p class="edu-meta">{edu.data.period} &mdash; {edu.data.location}</p>
        <div class="edu-focus">
          <edu.Content />
        </div>
      </article>
    ))}
  </div>
</SectionWrapper>

<script>
  import { gsap, ScrollTrigger } from '../utils/gsap-config';
  import { prefersReducedMotion } from '../utils/reduced-motion';

  function initAnimations() {
    if (prefersReducedMotion()) {
      gsap.set('.education-card', { opacity: 1, y: 0 });
      return;
    }

    const triggers: ScrollTrigger[] = [];

    const cardsTween = gsap.fromTo(
      '.education-card',
      { opacity: 0, y: 40 },
      {
        opacity: 1,
        y: 0,
        duration: 0.7,
        stagger: 0.12,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '#education',
          start: 'top 75%',
          once: true,
        },
      }
    );
    if (cardsTween.scrollTrigger) triggers.push(cardsTween.scrollTrigger);

    document.addEventListener('astro:before-swap', () => {
      triggers.forEach((t) => t.kill());
      triggers.length = 0;
    }, { once: true });
  }

  if ((window as any).__portfolioLoaderDone) {
    initAnimations();
  } else {
    window.addEventListener('preloader:done', initAnimations, { once: true });
  }
</script>

<style>
  .education-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .education-card {
    padding: 1.5rem;
    opacity: 0;
  }

  .edu-institution {
    margin: 0 0 0.35rem;
    font-family: var(--font-mono);
    font-size: var(--fs-headline-md);
    font-weight: 600;
    color: var(--primary);
    line-height: 1.3;
  }

  .edu-degree {
    margin: 0 0 0.5rem;
    font-family: var(--font-body);
    font-size: var(--fs-body-lg);
    color: var(--text);
    line-height: 1.6;
  }

  .edu-meta {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    line-height: 1;
  }

  .edu-focus :global(ul) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .edu-focus :global(li) {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--fs-code);
    color: var(--muted);
    border: 1px solid var(--outline-variant);
    border-radius: var(--radius-md);
    line-height: 1.5;
  }

  @media (min-width: 720px) {
    .education-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1040px) {
    .education-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
