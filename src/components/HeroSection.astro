---
import SplitText from './effects/SplitText.astro';
import { CV_DOWNLOAD_URL_EN } from '../config';
---

<section id="home" class="section hero">
  <div class="container hero-container">

    <!-- Label -->
    <p class="hero-label">&lt;Computer Science Engineer /&gt;</p>

    <!-- Photo + Name -->
    <div class="hero-main">
      <div
        class="hero-photo"
        role="img"
        aria-label="Profile photo of ROVOX - Software Engineer"
      >
        <img
          src="/images/profesional_photo.png"
          alt="Jose Roberto Vargas Orellana - Software Engineer"
          loading="eager"
          decoding="async"
        />
      </div>

      <div class="hero-info">
        <h1 class="hero-name section-title--scanner">
          <SplitText
            text="JOSE ROBERTO"
            as="span"
            class="hero-name-line"
            splitBy="words" />
          <SplitText
            text="VARGAS ORELLANA"
            as="span"
            class="hero-name-line"
            splitBy="words" />
          <span class="scanner-line" aria-hidden="true"></span>
        </h1>
        <p class="hero-title">Software Engineer</p>

        <!-- Action Buttons -->
        <div class="hero-actions">
          <a
            href="https://wa.me/59162642144"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary btn-icon"
            aria-label="WhatsApp"
          >
            <img
              src="/icons/whatsapp-logo-svgrepo-com.svg"
              alt="whatsapp icon contact"
              style="min-height: 45px; height: 55px; width: auto; object-fit: contain;"
            />
          </a>
          <a
            href="mailto:varor.joseroberto@gmail.com"
            class="btn btn-primary btn-icon"
            aria-label="Email"
          >
            <img
              src="/icons/gmail-svgrepo-com.svg"
              alt="gmail icon contact"
              style="min-height: 45px; height: 55px; width: auto; object-fit: contain;"
            />
          </a>
          <a
            href={CV_DOWNLOAD_URL_EN}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost"
          >
            Download CV
          </a>
        </div>
      </div>
    </div>

    <!-- Terminal Card -->
    <div class="hero-terminal glass-card card-glow">
      <div class="terminal-titlebar">
        <span class="terminal-dot" style="background:#ff5f56"></span>
        <span class="terminal-dot" style="background:#ffbd2e"></span>
        <span class="terminal-dot" style="background:#27c93f"></span>
        <span class="terminal-title">zsh — jrvargas.sh</span>
      </div>
      <div class="terminal-body">
        <p class="terminal-prompt">
          <span class="prompt-arrow">&gt;</span>
          <span class="prompt-path"> ~/about</span>
          <span class="prompt-cmd"> cat rovox.md</span>
        </p>
        <p class="terminal-line">
          <span class="line-hash">#</span> Software Engineer & Data Scientist
        </p>
        <p class="terminal-line">
          <span class="line-hash">#</span> Full Stack Web/Mobile/Desktop
        </p>
        <p class="terminal-line">
          <span class="line-hash">#</span> Bolivia 🇧🇴 | Open Source Advocate
        </p>
        <p class="terminal-line terminal-line-last">
          <span class="line-hash">#</span> Building tools that empower developers
        </p>
        <p class="terminal-prompt terminal-prompt-bottom">
          <span class="prompt-arrow">&gt;</span>
          <span class="prompt-path"> ~/about</span>
          <span class="cursor-blink" aria-hidden="true">&#9608;</span>
        </p>
      </div>
    </div>

  </div>
</section>

<script>
  import { defineModule } from '../utils/lifecycle';
  import { gsap, ScrollTrigger } from '../utils/gsap-config';
  import { prefersReducedMotion } from '../utils/reduced-motion';

  defineModule('hero', () => {
    const tweens: gsap.core.Tween[] = [];
    const terminalTriggers: ScrollTrigger[] = [];
    const pendingPreloaderCleanup: Array<() => void> = [];

    const startHeroAnimation = () => {
      // ── 1. Label ──
      tweens.push(
        gsap.fromTo(
          '.hero-label',
          { opacity: 0, y: 16 },
          { opacity: 1, y: 0, duration: 0.6, delay: 0.15 },
        ),
      );

      // ── 2. Photo ──
      tweens.push(
        gsap.fromTo(
          '.hero-photo',
          { opacity: 0, scale: 0.85 },
          { opacity: 1, scale: 1, duration: 0.9, delay: 0.35 },
        ),
      );

      // ── 3. Name words stagger ──
      tweens.push(
        gsap.fromTo(
          '.hero-name .split-item',
          { opacity: 0, y: 36, filter: 'blur(8px)' },
          {
            opacity: 1,
            y: 0,
            filter: 'blur(0px)',
            duration: 1.2,
            stagger: 0.09,
            delay: 0.5,
            ease: 'power3.out',
          },
        ),
      );

      // ── 4. Title (Software Engineer) ──
      tweens.push(
        gsap.fromTo(
          '.hero-title',
          { opacity: 0, y: 14 },
          { opacity: 1, y: 0, duration: 0.7, delay: 1.0 },
        ),
      );

      // ── 5. Terminal — typewriter-like staggered fades ──
      tweens.push(
        gsap.fromTo(
          '.terminal-prompt:first-child',
          { opacity: 0, x: -8 },
          { opacity: 1, x: 0, duration: 0.35, delay: 1.2 },
        ),
      );
      tweens.push(
        gsap.fromTo(
          '.terminal-line',
          { opacity: 0, x: -8 },
          {
            opacity: 1,
            x: 0,
            duration: 0.3,
            stagger: 0.12,
            delay: 1.45,
          },
        ),
      );
      tweens.push(
        gsap.fromTo(
          '.terminal-prompt-bottom',
          { opacity: 0, x: -8 },
          { opacity: 1, x: 0, duration: 0.35, delay: 1.85 },
        ),
      );

      // ── 6. Buttons fade up ──
      tweens.push(
        gsap.fromTo(
          '.hero-actions .btn',
          { opacity: 0, y: 24 },
          {
            opacity: 1,
            y: 0,
            duration: 0.55,
            stagger: 0.1,
            delay: 1.65,
          },
        ),
      );

      // ── 7. Scanner sweep on main title ──
      const scannerLine = document.querySelector('.hero .scanner-line');
      if (scannerLine) {
        tweens.push(
          gsap.fromTo(
            scannerLine,
            { scaleX: 0 },
            {
              scaleX: 1,
              duration: 0.6,
              ease: 'power2.out',
              delay: 1.2,
            },
          ),
          gsap.to(scannerLine, {
            opacity: 0,
            duration: 0.4,
            delay: 1.8,
          }),
        );
      }
    };

    // ── Terminal journey: lift → viewport center → hold → fade before skills ──
    const initTerminalAnimation = () => {
      const terminal = document.querySelector('.hero-terminal') as HTMLElement | null;
      if (!terminal) return;

      // Pin the terminal when its center reaches the viewport center.
      // It stays centered while the rest of the page scrolls,
      // and releases right before the skills section.
      terminalTriggers.push(
        ScrollTrigger.create({
          trigger: '.hero-terminal',
          start: 'center center',
          endTrigger: '#skills',
          end: 'top 65%',
          pin: true,
          pinSpacing: false,
        }),
      );

      // Fade out as the skills section approaches — the content
      // "loses visibility" before the next section takes over.
      const fadeTween = gsap.to(terminal, {
        opacity: 0,
        ease: 'none',
        scrollTrigger: {
          trigger: '#skills',
          start: 'top 80%',
          end: 'top 60%',
          scrub: 0.3,
        },
      });
      if (fadeTween.scrollTrigger) terminalTriggers.push(fadeTween.scrollTrigger);
    };

    // ── Preloader lifecycle ──
    // The terminal journey is SCROLL-DRIVEN (user-controlled motion), so it
    // must initialize even under prefers-reduced-motion — only the autonomous
    // entrance tweens are skipped for reduced-motion users.
    const afterPreloader = (fn: () => void) => {
      if ((window as any).__portfolioLoaderDone) {
        fn();
      } else {
        window.addEventListener('preloader:done', fn, { once: true });
        pendingPreloaderCleanup.push(() =>
          window.removeEventListener('preloader:done', fn),
        );
      }
    };

    // Journey always initializes (pin + drift + fade are scroll-linked)
    afterPreloader(initTerminalAnimation);

    if (prefersReducedMotion()) {
      // Reduced motion: show everything instantly, no entrance tweens
      gsap.set(
        [
          '.hero-label',
          '.hero-photo',
          '.hero-name .split-item',
          '.hero-title',
          '.hero-terminal',
          '.terminal-prompt',
          '.terminal-line',
          '.terminal-prompt-bottom',
          '.hero-actions .btn',
        ],
        { opacity: 1, y: 0, scale: 1, filter: 'none', x: 0 },
      );
      const scannerLineReduced = document.querySelector('.hero .scanner-line');
      if (scannerLineReduced) {
        gsap.set(scannerLineReduced, { opacity: 1, scaleX: 1 });
      }
    } else {
      // Entrance tweens only when motion is allowed
      let heroStarted = false;
      const guardedStart = () => {
        if (heroStarted) return;
        heroStarted = true;
        startHeroAnimation();
      };
      const heroTimer = setTimeout(guardedStart, 8000);
      pendingPreloaderCleanup.push(() => clearTimeout(heroTimer));
      afterPreloader(() => {
        clearTimeout(heroTimer);
        guardedStart();
      });
    }

    return () => {
      tweens.forEach((t) => t.kill());
      tweens.length = 0;
      terminalTriggers.forEach((st) => st.kill());
      terminalTriggers.length = 0;
      pendingPreloaderCleanup.forEach((fn) => fn());
      pendingPreloaderCleanup.length = 0;
    };
  });
</script>

<style>
  /* ── Section overrides ── */
  .hero {
    min-height: 100dvh;
    justify-content: center;
    text-align: center;
    padding-top: 10vh;
    padding-bottom: 40vh; /* Suficiente espacio para la zona de olas */
  }

  .hero .container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    position: relative;
    z-index: 1;
  }

  /* ── Scanlines overlay (dark mode only) ── */
  [data-theme="dark"] .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 3px,
      rgba(0, 242, 255, 0.02) 3px,
      rgba(0, 242, 255, 0.02) 6px
    );
    opacity: 0.5;
  }

  /* ── Label ── */
  .hero-label {
    font-family: var(--font-accent);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--primary-container);
    margin: 0;
    opacity: 0.85;
  }

  /* ── Main area: photo + info ── */
  .hero-main {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  /* ── Photo ── */
  .hero-photo {
    width: auto;
    height: 580px;
    aspect-ratio: 1/1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 2px solid var(--primary-container);
    box-shadow: 0 0 24px rgba(0, 242, 255, 0.12);
    /* flex-shrink: 0; */
    position: relative;
  }

  .hero-photo img {
    width: 100%;
    height: auto;
  }


  /* ── Name ── */
  .hero-info {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-name {
    position: relative;
    font-family: var(--font-mono);
    font-size: var(--fs-display);
    font-weight: 700;
    line-height: 1.15;
    color: var(--primary);
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-shadow: 0 0 20px rgba(0, 242, 255, 0.1);
  }

  .hero-name-line {
    display: block;
  }

  .scanner-line {
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--primary-container);
    transform: scaleX(0);
    transform-origin: left;
    opacity: 0.8;
  }

  .hero-title {
    font-family: var(--font-mono);
    font-size: var(--fs-headline-md);
    font-weight: 500;
    color: var(--muted);
    margin: 0.5rem 0 0;
  }

  /* ── Action Buttons ── */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin-top: 0.75rem;
  }

  .btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.65rem;
    min-width: 56px;
    min-height: 56px;
    border-radius: var(--radius-md);
    background: rgba(80, 82, 200, 1)
    border: 1px solid rgba(0, 242, 255, 0.22);
    box-shadow: 0 0 0 1px rgba(0, 242, 255, 0.04), 0 10px 18px rgba(0, 0, 0, 0.08);
  }

  .btn-icon img {
    display: block;
    width: 28px;
    height: 28px;
    object-fit: contain;
  }

  .btn-icon:hover {
    filter: contrast(80%);
    background: linear-gradient(135deg, #50c8c2, #2a856e); 
  }

  /* ── Terminal Card ── */
  .hero-terminal {
    width: 100%;
    max-width: 540px;
    overflow: hidden;
    text-align: left;
    margin-top: 0.25rem;
    /* No sticky — GSAP pin controls the journey (lift → center → hold → fade) */
    position: relative;
    z-index: 20;
    will-change: transform, opacity;
  }

  .terminal-titlebar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    background: var(--surface-container-high);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--muted);
  }

  .terminal-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .terminal-title {
    margin-left: 0.25rem;
  }

  .terminal-body {
    padding: 1rem 1.125rem;
    font-family: var(--font-mono);
    font-size: var(--fs-code);
    line-height: 1.65;
    color: var(--text);
  }

  .terminal-prompt {
    margin: 0 0 0.75rem;
    white-space: nowrap;
  }

  .terminal-prompt-bottom {
    margin: 0.75rem 0 0;
  }

  .prompt-arrow {
    color: var(--primary-container);
  }

  .prompt-path {
    color: var(--muted);
  }

  .prompt-cmd {
    color: var(--muted);
  }

  .terminal-line {
    margin: 0 0 0.25rem;
  }

  .terminal-line-last {
    margin-bottom: 0;
  }

  .line-hash {
    color: var(--primary-container);
    margin-right: 0.04em;
  }

  /* ── Blinking cursor ── */
  .cursor-blink {
    display: inline-block;
    color: var(--primary-container);
    animation: hero-cursor-blink 0.8s step-end infinite;
  }

  @keyframes hero-cursor-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  /* ── Desktop: side-by-side photo + info ── */
  @media (min-width: 720px) {
    .hero-main {
      flex-direction: row;
      gap: 2.25rem;
      text-align: left;
    }

    .hero-info {
      align-items: flex-start;
    }

    .hero-name {
      align-items: flex-start;
    }

    .hero-actions {
      justify-content: flex-start;
    }
  }

  /* ── Wide desktop: top padding tweak ── */
  @media (min-width: 1040px) {
    .hero {
      padding-top: 12vh;
      padding-bottom: 40vh;
    }

    .hero .container {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 3rem;
      align-items: start;
    }

    .hero-main {
      grid-column: 1;
      gap: 3rem;
    }

    .hero-terminal {
      grid-column: 2;
      max-width: 400px;
      margin-top: 0;
    }

    .hero-photo {
      max-width: 300px;
      height: 200px;
    }
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .cursor-blink {
      animation: none;
      opacity: 1;
    }

    [data-theme="dark"] .hero::after {
      display: none;
    }
  }

  /* ── Light mode contrast overrides ── */
  [data-theme="light"] .hero-label {
    color: var(--primary);
  }

  [data-theme="light"] .prompt-arrow,
  [data-theme="light"] .line-hash,
  [data-theme="light"] .cursor-blink {
    color: var(--primary-container);
  }

  [data-theme="light"] .scanner-line {
    background: var(--primary-container);
  }

  [data-theme="light"] .btn-icon {
    background: rgba(14, 116, 144, 0.07);
    border-color: rgba(14, 116, 144, 0.22);
    box-shadow: 0 0 0 1px rgba(14, 116, 144, 0.05), 0 10px 18px rgba(15, 23, 42, 0.06);
  }

  [data-theme="light"] .btn-icon img {
    filter: none;
  }

  [data-theme="light"] .btn-icon:hover img {
    filter: none;
  }

</style>
