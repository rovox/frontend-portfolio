---
import Button from './ui/Button.astro';
import SplitText from './effects/SplitText.astro';
---

<section class="section hero" id="home">
  <div class="container">

    <SplitText text="Jose Roberto Vargas Orellana" as="h1" class="hero-title" splitBy="words" />
    <p class="subtitle">&gt; Computer Engineer &amp; UI/UX Designer</p>
    <div class="hero-actions">
      <Button href="#projects" variant="primary">View Projects</Button>
      <Button href="#" variant="secondary">Download CV</Button>
      <Button href="#contact" variant="ghost">Contact Me</Button>
    </div>
  </div>
  <div class="scroll-indicator" aria-hidden="true">
    <span>Scroll</span>
    <div class="scroll-arrow"></div>
  </div>
</section>

<script>
  import { gsap } from '../utils/gsap-config';
  import { prefersReducedMotion } from '../utils/reduced-motion';

  if (prefersReducedMotion()) {
    gsap.set(['.hero-title .split-item', '.subtitle', '.hero-actions'], { 
      opacity: 1, y: 0, scale: 1, filter: 'none' 
    });
  } else {
    const animations: gsap.core.Tween[] = [];
    const hovers: gsap.core.Tween[] = [];

    const startHeroAnimation = () => {
      // Hero title parallax on scroll
      gsap.to('.hero .container', {
        y: -80,
        opacity: 0,
        ease: 'none',
        scrollTrigger: {
          trigger: '.hero',
          start: 'top top',
          end: 'bottom top',
          scrub: true,
        },
      });

      // Scroll indicator fades on scroll
      gsap.to('.scroll-indicator', {
        opacity: 0,
        y: -20,
        ease: 'none',
        scrollTrigger: {
          trigger: '.hero',
          start: 'top 85%',
          end: 'bottom top',
          scrub: true,
        },
      });

      animations.push(
        gsap.fromTo(
          '.hero-title .split-item',
          { opacity: 0, y: 40, filter: 'blur(8px)' },
          { opacity: 1, y: 0, filter: 'blur(0px)', duration: 1.5, ease: 'power3.out', delay: 0.3, stagger: 0.08 }
        )
      );

      animations.push(
        gsap.fromTo(
          '.subtitle',
          { opacity: 0, y: 20, filter: 'blur(6px)' },
          { opacity: 1, y: 0, filter: 'blur(0px)', duration: 1.2, ease: 'power3.out', delay: 0.6 }
        )
      );

      animations.push(
        gsap.fromTo(
          '.hero-actions',
          { opacity: 0, y: 15 },
          { opacity: 1, y: 0, duration: 1, ease: 'power3.out', delay: 0.9 }
        )
      );

      const title = document.querySelector('.hero-title');
      if (title) {
        hovers.push(
          gsap.to(title, {
            textShadow: '0 0 40px rgba(45, 226, 230, 0.5), 0 0 80px rgba(45, 226, 230, 0.3)',
            duration: 0.4,
            ease: 'power2.out',
            paused: true,
          })
        );
        title.addEventListener('mouseenter', () => hovers[0]?.play());
        title.addEventListener('mouseleave', () => hovers[0]?.reverse());
      }

      const ctaButtons = document.querySelectorAll('.hero-actions .btn');
      ctaButtons.forEach((btn) => {
        const hoverAnim = gsap.to(btn, {
          scale: 1.05,
          borderColor: 'rgba(45, 226, 230, 0.9)',
          boxShadow: '0 0 25px rgba(45, 226, 230, 0.35)',
          duration: 0.25,
          ease: 'power2.out',
          paused: true,
        });
        btn.addEventListener('mouseenter', () => hoverAnim.play());
        btn.addEventListener('mouseleave', () => hoverAnim.reverse());
      });
    };

    if (window.__portfolioLoaderDone) {
      startHeroAnimation();
    } else {
      const heroTimer = setTimeout(startHeroAnimation, 8000);
      window.addEventListener('preloader:done', startHeroAnimation, { once: true });
      window.addEventListener('preloader:done', () => clearTimeout(heroTimer), { once: true });
    }

    const cleanup = () => {
      animations.forEach((t) => t.kill());
      animations.length = 0;
      hovers.forEach((t) => t.kill());
      hovers.length = 0;
    };

    document.addEventListener('astro:before-swap', cleanup, { once: true });
  }
</script>

<style>
  .hero {
    text-align: center;
    position: relative;
    z-index: 10;
    min-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero::before,
  .hero::after {
    content: '';
    position: absolute;
    width: 60px;
    height: 60px;
    border-color: var(--primary);
    border-style: solid;
    opacity: 0.4;
    pointer-events: none;
  }

  .hero::before {
    top: 2rem;
    left: 2rem;
    border-width: 2px 0 0 2px;
  }

  .hero::after {
    bottom: 2rem;
    right: 2rem;
    border-width: 0 2px 2px 0;
  }

  .hero .container::before,
  .hero .container::after {
    content: '';
    position: absolute;
    width: 60px;
    height: 60px;
    border-color: var(--accent);
    border-style: solid;
    opacity: 0.3;
    pointer-events: none;
  }

  .hero .container::before {
    top: 2rem;
    right: 2rem;
    border-width: 2px 2px 0 0;
  }

  .hero .container::after {
    bottom: 2rem;
    left: 2rem;
    border-width: 0 0 2px 2px;
  }

  .container {
    position: relative;
    z-index: 2;
  }

  .hero-title {
    font-size: clamp(3rem, 9vw, 6.5rem);
    line-height: 1.08;
    margin: 0;
    font-family: var(--font-mono);
    text-shadow: 0 0 25px rgba(45, 226, 230, 0.22);
  }

  .subtitle {
    margin-top: 1rem;
    font-size: clamp(1.1rem, 3.3vw, 1.6rem);
    color: var(--muted);
    font-family: var(--font-mono);
  }

  .hero-actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0;
    animation: fadeInScroll 1s ease 2s forwards;
  }

  .scroll-arrow {
    width: 20px;
    height: 20px;
    border-right: 2px solid var(--primary);
    border-bottom: 2px solid var(--primary);
    transform: rotate(45deg);
    animation: bounceScroll 2s ease infinite;
  }

  @keyframes fadeInScroll {
    to { opacity: 1; }
  }

  @keyframes bounceScroll {
    0%, 20%, 50%, 80%, 100% { transform: rotate(45deg) translateY(0); }
    40% { transform: rotate(45deg) translateY(6px); }
    60% { transform: rotate(45deg) translateY(3px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-indicator {
      animation: none;
      opacity: 1;
    }
    .scroll-arrow {
      animation: none;
    }
  }
</style>
