---
import { render, type CollectionEntry } from 'astro:content';
import SectionWrapper from './ui/SectionWrapper.astro';

interface Props {
  items: CollectionEntry<'experiences'>[];
}

const { items } = Astro.props;
const rendered = await Promise.all(
  items.map(async (item) => {
    const { Content } = await render(item);
    return { ...item, Content };
  })
);
---

<SectionWrapper id="experience" title="&lt;Experience /&gt;" note="// Professional journey and academic foundations">
  <div class="filter-chips" data-filter-section="experiences">
    <button class="filter-chip is-active" data-filter="all">All</button>
    <button class="filter-chip" data-filter="professional">Professional</button>
    <button class="filter-chip" data-filter="university">University</button>
  </div>

  <div class="exp-grid" id="exp-grid">
    {rendered.map((exp) => (
      <article class="filter-item glass-card card-glow exp-card" data-type={exp.data.type} data-tags={exp.data.tags.join(' ')}>
        <div class="exp-card-top">
          <span class="exp-period">{exp.data.period}</span>
          <span class="exp-type-badge">
            {exp.data.type === 'professional' ? 'PRO' : 'UNI'}
          </span>
        </div>
        <h3 class="exp-role">{exp.data.role}</h3>
        <p class="exp-company">
          {exp.data.company}{exp.data.location ? ` — ${exp.data.location}` : ''}
        </p>
        <div class="exp-tech-tags">
          {exp.data.technologies.map((tech) => (
            <span class="exp-tech">{tech}</span>
          ))}
        </div>
        <div class="exp-highlights">
          <exp.Content />
        </div>
      </article>
    ))}
  </div>
</SectionWrapper>

<script>
  import { gsap, ScrollTrigger } from '../utils/gsap-config';
  import { prefersReducedMotion } from '../utils/reduced-motion';

  function initAnimations() {
    if (prefersReducedMotion()) {
      gsap.set('.exp-card', { opacity: 1, y: 0 });
      return;
    }

    const triggers: ScrollTrigger[] = [];

    const cardsTween = gsap.fromTo(
      '.exp-card',
      { opacity: 0, y: 40 },
      {
        opacity: 1,
        y: 0,
        duration: 0.7,
        stagger: 0.08,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '#experience',
          start: 'top 70%',
          once: true,
        },
      }
    );
    if (cardsTween.scrollTrigger) triggers.push(cardsTween.scrollTrigger);

    document.addEventListener(
      'astro:before-swap',
      () => {
        triggers.forEach((t) => t.kill());
        triggers.length = 0;
      },
      { once: true }
    );
  }

  if ((window as any).__portfolioLoaderDone) {
    initAnimations();
  } else {
    window.addEventListener('preloader:done', initAnimations, { once: true });
  }
</script>

<style>
  /* Grid: mobile 1-col, tablet+ 2-col */
  .exp-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  /* Card */
  .exp-card {
    padding: 1.5rem;
    opacity: 0;
  }

  /* Top row: period left + type badge right */
  .exp-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
    gap: 0.75rem;
  }

  .exp-period {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    color: var(--muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .exp-type-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--primary-container);
    border: 1px solid var(--primary-container);
    border-radius: var(--radius-full);
    padding: 0.15rem 0.6rem;
    flex-shrink: 0;
  }

  /* Role */
  .exp-role {
    font-family: var(--font-mono);
    font-size: var(--fs-headline-md);
    font-weight: 600;
    color: var(--primary);
    margin: 0 0 0.3rem;
    line-height: 1.3;
  }

  /* Company + Location */
  .exp-company {
    font-size: var(--fs-body-md);
    color: var(--muted);
    margin: 0 0 1rem;
    line-height: 1.5;
  }

  /* Technology tags — border-only pills */
  .exp-tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 1rem;
  }

  .exp-tech {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--fs-code);
    color: var(--muted);
    border: 1px solid var(--outline-variant);
    border-radius: var(--radius-md);
    padding: 0.15rem 0.5rem;
    white-space: nowrap;
  }

  /* Highlights — terminal-style `>` prefix with muted body */
  .exp-highlights :global(ul) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .exp-highlights :global(li) {
    font-size: var(--fs-body-md);
    color: var(--muted);
    line-height: 1.55;
    padding-left: 0;
  }

  .exp-highlights :global(li)::before {
    content: '> ';
    color: var(--primary-container);
    font-family: var(--font-mono);
    font-weight: 600;
  }

  @media (min-width: 720px) {
    .exp-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1040px) {
    .exp-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
