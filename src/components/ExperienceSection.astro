---
import { useTranslations } from '../i18n/ui';
import { render, type CollectionEntry } from 'astro:content';
import SectionWrapper from './ui/SectionWrapper.astro';
import Carousel from './ui/Carousel.astro';

interface Props {
  items: CollectionEntry<'experiences'>[];
}

const { items } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const rendered = await Promise.all(
  items.map(async (item) => {
    const { Content } = await render(item);
    return { ...item, Content };
  })
);
---

<SectionWrapper id="experience" title={t('experience.title')} note={t('experience.note')}>
  <div class="filter-chips" data-filter-section="experiences">
    <button class="filter-chip is-active" data-filter="all">{t('filter.all')}</button>
    <button class="filter-chip" data-filter="professional">{t('filter.professional')}</button>
    <button class="filter-chip" data-filter="university">{t('filter.university')}</button>
  </div>

  <Carousel id="experience" cardSelector=".exp-card">
    {rendered.map((exp) => (
      <article class="filter-item glass-card card-glow exp-card" data-type={exp.data.type} data-tags={`${exp.data.type} ${exp.data.tags.join(' ')}`}>
        <div class="exp-card-top">
          <span class="exp-period">{exp.data.period}</span>
        </div>
        <h3 class="exp-role">{exp.data.role}</h3>
        <p class="exp-company">
          {exp.data.company}{exp.data.location ? ` — ${exp.data.location}` : ''}
        </p>
        <div class="exp-tech-tags">
          {exp.data.technologies.map((tech) => (
            <span class="exp-tech">{tech}</span>
          ))}
        </div>
        <div class="exp-highlights">
          <exp.Content />
        </div>
      </article>
    ))}
  </Carousel>
</SectionWrapper>

<script>
import { defineModule } from '../utils/lifecycle';
import { gsap, ScrollTrigger } from '../utils/gsap-config';
import { prefersReducedMotion } from '../utils/reduced-motion';

  defineModule('experience', () => {
    const triggers: ScrollTrigger[] = [];

    function init() {
      if (prefersReducedMotion()) {
        gsap.set('#experience .carousel-root', { opacity: 1, y: 0 });
        return;
      }

      // Fade the whole carousel section as one unit.
      const tween = gsap.fromTo(
        '#experience .carousel-root',
        { opacity: 0, y: 30 },
        {
          opacity: 1,
          y: 0,
          duration: 0.8,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: '#experience',
            start: 'top 70%',
            once: true,
          },
        }
      );
      if (tween.scrollTrigger) triggers.push(tween.scrollTrigger);
    }

    if ((window as any).__portfolioLoaderDone) {
      init();
    } else {
      const handler = () => {
        init();
        requestAnimationFrame(() => ScrollTrigger.refresh());
      };
      window.addEventListener('preloader:done', handler, { once: true });
    }

    return () => {
      triggers.forEach((t) => t.kill());
      triggers.length = 0;
    };
  });
</script>

<style>
  /* Card internals (layout is handled by Carousel) */
  .exp-card {
    padding: 1.5rem;
    opacity: 1;
  }

  /* Top row: period */
  .exp-card-top {
    display: flex;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .exp-period {
    font-family: var(--font-accent);
    font-size: var(--fs-label);
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  /* Role */
  .exp-role {
    font-family: var(--font-mono);
    font-size: var(--fs-headline-md);
    font-weight: 600;
    color: var(--primary);
    margin: 0 0 0.3rem;
    line-height: 1.3;
  }

  /* Company + Location */
  .exp-company {
    font-size: var(--fs-body-md);
    color: var(--muted);
    margin: 0 0 1rem;
    line-height: 1.5;
  }

  /* Technology tags — border-only pills */
  .exp-tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 1rem;
  }

  .exp-tech {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--fs-code);
    color: var(--muted);
    border: 1px solid var(--outline-variant);
    border-radius: var(--radius-md);
    padding: 0.15rem 0.5rem;
    white-space: nowrap;
  }

  /* Highlights — terminal-style `>` prefix with muted body */
  .exp-highlights :global(ul) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .exp-highlights :global(li) {
    font-size: var(--fs-body-md);
    color: var(--muted);
    line-height: 1.55;
    padding-left: 0;
  }

  .exp-highlights :global(li)::before {
    content: '> ';
    color: var(--primary-container);
    font-family: var(--font-mono);
    font-weight: 600;
  }
</style>
