---
import { render, type CollectionEntry } from 'astro:content';
import SectionWrapper from './ui/SectionWrapper.astro';
import Carousel from './ui/Carousel.astro';

interface Props {
  items: CollectionEntry<'skills'>[];
}

const { items } = Astro.props;
const rendered = await Promise.all(
  items.map(async (item) => {
    const { Content } = await render(item);
    return { ...item, Content };
  })
);

const iconGlyphs: Record<string, string> = {
  terminal: '>_',
  token: '\u2B21',
  view_in_ar: '\u25C7',
  smartphone: '\u25A3',
  dns: '\u25C8',
  neurology: '\u25CE',
};
---

<SectionWrapper id="skills" title="&lt;Skills /&gt;" note="// Technical expertise and creative capabilities">
  <Carousel id="skills" cardSelector=".skill-card">
    {rendered.map((skill) => (
      <div class="skill-card glass-card card-glow">
        <div class="skill-header">
          <span class="skill-icon" aria-hidden="true">{iconGlyphs[skill.data.icon] || '\u25B8'}</span>
          <h3 class="skill-title">{skill.data.title}</h3>
        </div>
        <div class="skill-list">
          <skill.Content />
        </div>
      </div>
    ))}
  </Carousel>
</SectionWrapper>

<script>
import { defineModule } from '../utils/lifecycle';
import { gsap, ScrollTrigger } from '../utils/gsap-config';
import { prefersReducedMotion } from '../utils/reduced-motion';

  defineModule('skills', () => {
    const triggers: ScrollTrigger[] = [];

    function init() {
      if (prefersReducedMotion()) {
        gsap.set('#skills .carousel-root', { opacity: 1, y: 0 });
        return;
      }

      const tween = gsap.fromTo(
        '#skills .carousel-root',
        { opacity: 0, y: 30 },
        {
          opacity: 1,
          y: 0,
          duration: 0.8,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: '#skills',
            start: 'top 75%',
            once: true,
          },
        }
      );

      if (tween.scrollTrigger) triggers.push(tween.scrollTrigger);
    }

    if ((window as any).__portfolioLoaderDone) {
      init();
    } else {
      const handler = () => {
        init();
        requestAnimationFrame(() => ScrollTrigger.refresh());
      };
      window.addEventListener('preloader:done', handler, { once: true });
    }

    return () => {
      triggers.forEach((t) => t.kill());
      triggers.length = 0;
    };
  });
</script>

<style>
  .skill-card {
    padding: 1.5rem;
    opacity: 1;
  }

  .skill-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .skill-icon {
    color: var(--primary-container);
    font-family: var(--font-mono);
    font-size: 1.25rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .skill-title {
    margin: 0;
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: var(--fs-headline-md);
    font-weight: 600;
    line-height: 1.3;
  }

  .skill-list :global(ul) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .skill-list :global(li) {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--fs-code);
    line-height: 1.5;
  }

  .skill-list :global(li)::before {
    content: '> ';
    color: var(--primary-container);
    font-family: var(--font-mono);
  }
</style>
