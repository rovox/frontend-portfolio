---
import type { CollectionEntry } from 'astro:content';
import Card from './ui/Card.astro';
import Tag from './ui/Tag.astro';
import RevealMask from './effects/RevealMask.astro';

interface Props {
  items: CollectionEntry<'projects'>[];
}

const { items } = Astro.props;

// Detect if a URL is a Google Colab link
function isColabUrl(url: string): boolean {
  return url.includes('colab.research.google.com');
}

// Extract GitHub repo name from URL (e.g., "rovox/Evolve-Taller")
function repoName(url: string): string {
  try {
    const parts = new URL(url).pathname.split('/').filter(Boolean);
    return parts.length >= 2 ? `${parts[0]}/${parts[1]}` : '';
  } catch {
    return '';
  }
}
---

<section class="section" id="work">
  <div class="container">
    <h2 class="section-title section-title--scanner">
      &lt;Projects /&gt;
      <span class="scanner-line" aria-hidden="true"></span>
    </h2>
    <p class="section-note">// Featured work and open source contributions</p>

  <!-- <div class="filter-chips" data-filter-section="projects">
    <button class="filter-chip is-active" data-filter="all">All</button>
    <button class="filter-chip" data-filter="web">Web</button>
    <button class="filter-chip" data-filter="blockchain">Blockchain</button>
    <button class="filter-chip" data-filter="mobile">Mobile</button>
    <button class="filter-chip" data-filter="design">Design</button>
  </div> -->

  <div class="projects-grid" id="projects-grid">
    {items.map((project) => (
      <RevealMask direction="bottom">
        <Card as="article" glow class="filter-item project-card glass-card card-glow" data-tags={project.data.tags.join(' ')}>
          {project.data.preview && (
            <img src={project.data.preview} alt="" class="project-preview" loading="lazy" decoding="async" />
          )}
          <Tag variant="primary">{project.data.category.toUpperCase()}</Tag>
          <h3>{project.data.title}</h3>
          <p class="card-desc">{project.data.description}</p>
          <div class="tags">
            {project.data.technologies.map((tech) => (
              <Tag>{tech}</Tag>
            ))}
          </div>
          {
            (project.data.githubUrl || project.data.liveUrl || project.data.blogUrl) && (
              <div class="project-footer">
                <div class="project-links">
                  {project.data.githubUrl && (
                    isColabUrl(project.data.githubUrl) ? (
                      <a href={project.data.githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary project-btn" aria-label="Open in Google Colab">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 3v18"/><circle cx="14" cy="10" r="1.5"/><circle cx="14" cy="14" r="1.5"/></svg>
                        <span>Colab</span>
                      </a>
                    ) : (
                      <a href={project.data.githubUrl} target="_blank" rel="noopener noreferrer" class="project-link-icon" aria-label="View on GitHub">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                        <span>{repoName(project.data.githubUrl)}</span>
                      </a>
                    )
                  )}
                  {project.data.liveUrl && (
                    <a href={project.data.liveUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary project-btn" aria-label="Open live site">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                      <span>Live</span>
                    </a>
                  )}
                  {project.data.blogUrl && (
                    <a href={project.data.blogUrl} target="_blank" rel="noopener noreferrer" class="project-link-icon" aria-label="Read blog post">
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.85 6.89c.03-.3-.08-.59-.3-.78L.3 3.4v-.4h6.96l5.38 11.8L17.36 3h6.63v.4l-1.91 1.84c-.17.13-.25.33-.21.54v13.5c-.04.2.04.41.21.53l1.87 1.84v.4h-9.4v-.4l1.93-1.88c.19-.19.19-.25.19-.54V10.9l-5.39 13.69h-.73L4.8 10.9v9.18c-.05.38.08.77.35 1.05l2.52 3.06v.4H.52v-.4l2.52-3.06c.27-.28.39-.67.33-1.05V10.6z"/></svg>
                      <span>Blog</span>
                    </a>
                  )}
                </div>
              </div>
            )
          }
        </Card>
      </RevealMask>
    ))}
  </div>
  </div>
</section>

<script>
import { defineModule } from '../utils/lifecycle';
import { gsap, ScrollTrigger } from '../utils/gsap-config';
import { prefersReducedMotion } from '../utils/reduced-motion';

  defineModule('projects', () => {
    const triggers: ScrollTrigger[] = [];

    function init() {
      if (prefersReducedMotion()) {
        gsap.set('.project-card', { opacity: 1, y: 0 });
        const scannerLineReduced = document.querySelector('#work .scanner-line');
        if (scannerLineReduced) {
          gsap.set(scannerLineReduced, { opacity: 1, scaleX: 1 });
        }
        return;
      }

      const cardsTween = gsap.fromTo(
        '.project-card',
        { opacity: 0, y: 40 },
        {
          opacity: 1,
          y: 0,
          duration: 0.7,
          stagger: 0.1,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: '#work',
            start: 'top 70%',
            once: true,
          },
        }
      );
      if (cardsTween.scrollTrigger) triggers.push(cardsTween.scrollTrigger);

      // ── Scanner sweep on section title ──
      const scannerLine = document.querySelector('#work .scanner-line');
      if (scannerLine) {
        const scannerFrom = gsap.fromTo(
          scannerLine,
          { scaleX: 0 },
          {
            scaleX: 1,
            duration: 0.6,
            ease: 'power2.out',
            scrollTrigger: {
              trigger: '#work',
              start: 'top 80%',
              toggleActions: 'play none none none',
            },
          },
        );
        if (scannerFrom.scrollTrigger) triggers.push(scannerFrom.scrollTrigger);

        const scannerTo = gsap.to(scannerLine, {
          opacity: 0,
          duration: 0.4,
          delay: 0.6,
          scrollTrigger: {
            trigger: '#work',
            start: 'top 80%',
            toggleActions: 'play none none none',
          },
        });
        if (scannerTo.scrollTrigger) triggers.push(scannerTo.scrollTrigger);
      }
    }

    if ((window as any).__portfolioLoaderDone) {
      init();
    } else {
      const handler = () => {
        init();
        requestAnimationFrame(() => ScrollTrigger.refresh());
      };
      window.addEventListener('preloader:done', handler, { once: true });
    }

    return () => {
      triggers.forEach((t) => t.kill());
      triggers.length = 0;
    };
  });
</script>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .project-card {
    padding: 1.25rem;
    opacity: 1;
    transition: border-color 0.3s ease, filter 0.3s ease;
    overflow: hidden;
  }

  .project-card:hover {
    border-color: var(--primary-container);
    filter: drop-shadow(0 0 12px rgba(0, 242, 255, 0.25));
  }

  [data-theme="light"] .project-card:hover {
    border-color: var(--primary-container);
    filter: none;
  }

  .scanner-line {
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--primary-container);
    transform: scaleX(0);
    transform-origin: left;
    opacity: 0.8;
  }

  .section-title--scanner {
    position: relative;
  }

  .project-preview {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    margin: -1.25rem -1.25rem 0.75rem -1.25rem;
    display: block;
    width: calc(100% + 2.5rem);
    border-bottom: 1px solid var(--border);
  }

  .project-card h3 {
    margin: 0.4rem 0 0.55rem;
    font-family: var(--font-mono);
  }

  .card-desc {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.9rem 0;
  }

  .project-footer {
    display: flex;
    justify-content: flex-start;
    gap: 0.75rem;
    align-items: center;
    font-size: 0.86rem;
    margin-top: 0.6rem;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .project-link-icon {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--primary-container);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    transition: opacity var(--transition-fast), color var(--transition-fast);
    text-decoration: none;
  }

  .project-link-icon svg {
    flex-shrink: 0;
  }

  .project-link-icon:hover {
    opacity: 0.7;
    color: var(--primary);
  }

  /* ── Project action buttons (Live/Colab) ── */
  .project-btn {
    padding: 0.4rem 0.85rem;
    font-family: var(--font-mono);
    font-size: var(--fs-code);
    font-weight: 600;
    border-radius: var(--radius-full);
    letter-spacing: 0.02em;
    gap: 0.4rem;
  }

  .project-btn:hover {
    box-shadow: 0 0 14px rgba(0, 242, 255, 0.25);
  }

  [data-theme="light"] .project-btn:hover {
    box-shadow: 0 0 14px rgba(14, 116, 144, 0.18);
  }

  .project-btn svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  @media (min-width: 720px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1040px) {
    .projects-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .project-card:hover {
      filter: none;
    }
  }
</style>
