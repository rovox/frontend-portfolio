---
interface SocialLink {
  label: string;
  href: string;
}

interface Props {
  socialLinks: SocialLink[];
}

const { socialLinks } = Astro.props;

const gmailLink = socialLinks.find(
  (l) => l.label.toLowerCase() === 'gmail' || l.label.toLowerCase() === 'email',
);
const whatsappLink = socialLinks.find(
  (l) => l.label.toLowerCase() === 'whatsapp',
);

function linkAttrs(href: string) {
  if (href.startsWith('http')) {
    return { target: '_blank', rel: 'noopener noreferrer' };
  }
  return {};
}
---

<section id="contact" class="section contact-section">
  <div class="container contact-container">
    <!-- CTA Glass Card -->
    <div class="cta-card glass-card">
      <span class="cta-icon" aria-hidden="true">🚀</span>

      <h2 class="cta-title">Let's Work Together</h2>

      <p class="cta-desc">
        Currently accepting technical consultations
        and select freelance opportunities.
      </p>

      <div class="cta-buttons">
        {
          gmailLink && (
            <a
              href={gmailLink.href}
              class="btn btn-primary cta-btn"
              {...linkAttrs(gmailLink.href)}
            >
              GMAIL
            </a>
          )
        }
        {
          whatsappLink && (
            <a
              href={whatsappLink.href}
              class="btn btn-primary cta-btn"
              {...linkAttrs(whatsappLink.href)}
            >
              WHATSAPP
            </a>
          )
        }
      </div>
    </div>

    <!-- Footer (outside the glass card) -->
    <footer class="contact-footer">
      <p class="footer-name">ROVOX</p>
      <p class="footer-title">Software Engineer</p>

      <nav class="footer-links" aria-label="Social links">
        <a href="https://github.com/rovox" target="_blank" rel="noopener noreferrer" class="footer-link" aria-label="GitHub">
          <img src="/icons/github-svgrepo-com.svg" alt="" width="20" height="20" />
        </a>
        <a href="https://linkedin.com/in/rovox" target="_blank" rel="noopener noreferrer" class="footer-link" aria-label="LinkedIn">
          <img src="/icons/linkedin-logo-svgrepo-com.svg" alt="" width="20" height="20" />
        </a>
        <a href="https://wa.me/59162642144" target="_blank" rel="noopener noreferrer" class="footer-link" aria-label="WhatsApp">
          <img src="/icons/whatsapp-logo-svgrepo-com.svg" alt="" width="20" height="20" />
        </a>
        <a href="mailto:varor.joseroberto@gmail.com" class="footer-link" aria-label="Email">
          <img src="/icons/gmail-svgrepo-com.svg" alt="" width="20" height="20" />
        </a>
      </nav>

      <p class="footer-copyright">
        &copy; {new Date().getFullYear()} Jose Roberto Vargas Orellana
        &mdash; Built with Precision Protocol
      </p>
    </footer>
  </div>
</section>

<script>
  import { defineModule } from '../utils/lifecycle';
  import { gsap, ScrollTrigger } from '../utils/gsap-config';
  import { prefersReducedMotion } from '../utils/reduced-motion';

  defineModule('contact', () => {
    const triggers: ScrollTrigger[] = [];
    let pendingPreloaderCleanup: (() => void) | null = null;

    function initAnimations() {
      if (prefersReducedMotion()) {
        gsap.set(
          ['.cta-title', '.cta-desc', '.cta-btn'],
          { opacity: 1, y: 0, scale: 1 },
        );
        return;
      }

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: '#contact',
          start: 'top 72%',
          once: true,
        },
      });

      if (tl.scrollTrigger) triggers.push(tl.scrollTrigger);

      tl.fromTo(
        '.cta-title',
        { opacity: 0, y: 30 },
        { opacity: 1, y: 0, duration: 0.7 },
      )
        .fromTo(
          '.cta-desc',
          { opacity: 0, y: 20 },
          { opacity: 1, y: 0, duration: 0.6 },
          '-=0.35',
        )
        .fromTo(
          '.cta-btn',
          { opacity: 0, scale: 0.85 },
          {
            opacity: 1,
            scale: 1,
            duration: 0.5,
            stagger: 0.1,
            ease: 'back.out(1.4)',
          },
          '-=0.2',
        );
    }

    if ((window as any).__portfolioLoaderDone) {
      initAnimations();
    } else {
      const handler = () => initAnimations();
      window.addEventListener('preloader:done', handler, { once: true });
      pendingPreloaderCleanup = () => window.removeEventListener('preloader:done', handler);
    }

    return () => {
      triggers.forEach((st) => st.kill());
      triggers.length = 0;
      pendingPreloaderCleanup?.();
      pendingPreloaderCleanup = null;
    };
  });
</script>

<style>
  .contact-section {
    padding-bottom: 4rem;
  }

  .contact-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4rem;
  }

  /* ── CTA Card ── */
  .cta-card {
    width: 100%;
    max-width: 680px;
    padding: 3rem 1.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .cta-icon {
    font-size: 2.5rem;
    line-height: 1;
    display: block;
  }

  .cta-title {
    font-family: var(--font-mono);
    font-size: var(--fs-display);
    font-weight: 700;
    color: var(--primary);
    line-height: 1.15;
    opacity: 0;
  }

  .cta-desc {
    font-family: var(--font-body);
    font-size: var(--fs-body-lg);
    color: var(--muted);
    line-height: 1.6;
    max-width: 480px;
    opacity: 0;
  }

  /* ── CTA Buttons ── */
  .cta-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    max-width: 320px;
    margin-top: 0.25rem;
  }

  .cta-btn {
    width: 100%;
    padding: 0.85rem 1.5rem;
    font-size: var(--fs-label);
    letter-spacing: 0.1em;
    font-weight: 700;
    text-transform: uppercase;
    opacity: 0;
  }

  /* ── Footer ── */
  .contact-footer {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .footer-name {
    font-family: var(--font-mono);
    font-size: var(--fs-headline-md);
    font-weight: 600;
    color: var(--primary);
    line-height: 1.3;
  }

  .footer-title {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 0.25rem;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    border-radius: var(--radius-md);
    transition: background var(--transition-fast);
  }

  .footer-link:hover {
    background: rgba(0, 242, 255, 0.1);
  }

  .footer-link:focus-visible {
    outline: 2px solid var(--primary-container);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .footer-link img {
    width: 20px;
    height: 20px;
    filter: grayscale(100%) brightness(0.7);
    transition: filter 0.2s ease;
  }

  .footer-link:hover img {
    filter: grayscale(0%) brightness(1);
  }

  .footer-copyright {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: color-mix(in srgb, var(--muted) 50%, transparent);
    line-height: 1.5;
    margin-top: 0.5rem;
  }

  /* ── Responsive ── */
  @media (min-width: 540px) {
    .cta-buttons {
      flex-direction: row;
      max-width: none;
      justify-content: center;
    }

    .cta-btn {
      width: auto;
      min-width: 160px;
    }
  }

  @media (min-width: 720px) {
    .contact-container {
      gap: 5rem;
    }

    .cta-card {
      padding: 5rem 3rem;
      gap: 1.5rem;
    }

    .cta-icon {
      font-size: 3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-title,
    .cta-desc,
    .cta-btn {
      opacity: 1;
    }
  }
</style>
