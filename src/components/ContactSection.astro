---
import { FORMSPREE_ENDPOINT, GITHUB_URL, LINKEDIN_URL, MEDIUM_URL } from '../config';
---

<section id="contact" class="section contact-section">
  <div class="container contact-container">
    <!-- CTA Glass Card -->
    <div class="cta-card glass-card">
      <span class="cta-icon" aria-hidden="true">🚀</span>

      <h2 class="cta-title">Let's Work Together</h2>

      <p class="cta-desc">
        Currently accepting technical consultations
        and select freelance opportunities.
      </p>

      <!-- Formspree contact form -->
      <form
        class="contact-form"
        action={FORMSPREE_ENDPOINT}
        method="POST"
      >
        <div class="form-field">
          <label for="contact-name">Name</label>
          <input type="text" id="contact-name" name="name" autocomplete="name" />
        </div>

        <div class="form-field">
          <label for="contact-email">
            Email <span class="required-mark" aria-hidden="true">*</span>
          </label>
          <input
            type="email"
            id="contact-email"
            name="email"
            required
            autocomplete="email"
            aria-required="true"
          />
        </div>

        <div class="form-field">
          <label for="contact-message">
            Message <span class="required-mark" aria-hidden="true">*</span>
          </label>
          <textarea
            id="contact-message"
            name="message"
            required
            rows="4"
            aria-required="true"
          ></textarea>
        </div>

        <!-- Honeypot -->
        <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
        <input type="hidden" name="_next" value="/?submitted=1#contact" />

        <p class="form-privacy">
          Your data is sent securely via Formspree. No tracking, no analytics.
        </p>

        <button type="submit" class="btn btn-primary contact-submit">
          Send message
        </button>
      </form>

      <p class="form-success" hidden>
        ✓ Message sent. I'll get back to you soon.
      </p>

      <!-- Social Links inside CTA card -->
      <nav class="cta-socials" aria-label="Social links">
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="cta-social-link" aria-label="GitHub">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M24.92 12.183c0-1.586-.604-2.864-1.585-3.83.172-.547.398-1.763-.229-3.321 0 0-1.114-.348-3.628 1.315a12.695 12.695 0 0 0-3.081-.366c-1.154 0-2.322.143-3.409.44-2.596-1.747-3.74-1.391-3.74-1.391-.748 1.847-.287 3.215-.145 3.554-.883.936-1.414 2.133-1.414 3.594 0 1.111.128 2.099.44 2.964l.325.732c.879 1.614 2.606 2.655 5.677 2.983-.434.289-.885.779-1.062 1.612-.594.28-2.475.966-3.603-.944 0 0-.633-1.148-1.842-1.235 0 0-1.174-.017-.08.722 0 0 .782.367 1.326 1.738 0 0 .705 2.342 4.114 1.593v2.417s-.076.857-.867 1.143c0 0-.469.312.034.497 0 0 2.205.174 2.205-1.604v-2.643s-.09-1.047.429-1.404v4.332s-.032 1.031-.576 1.421c0 0-.362.646.433.468 0 0 1.517-.211 1.584-1.967l.035-4.383h.363l.033 4.383c.076 1.748 1.59 1.967 1.59 1.967.793.179.429-.468.429-.468-.54-.389-.579-1.421-.579-1.421v-4.297c.52.402.436 1.369.436 1.369v2.643c0 1.777 2.2 1.604 2.2 1.604.505-.186.036-.498.036-.498-.793-.286-.867-1.143-.867-1.143v-3.461c0-1.346-.574-2.056-1.137-2.435 3.277-.318 4.845-1.368 5.572-2.99-.015.027.26-.726.26-.726.25-.859.325-1.855.325-2.963h-.002z"/></svg>
        </a>
        <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" class="cta-social-link" aria-label="LinkedIn">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M12.225 12.225h-1.778V9.44c0-.664-.012-1.519-.925-1.519-.926 0-1.068.724-1.068 1.47v2.834H6.676V6.498h1.707v.783h.024c.348-.594.996-.95 1.684-.925 1.802 0 2.135 1.185 2.135 2.728l-.001 3.14zM4.67 5.715a1.037 1.037 0 01-1.032-1.031c0-.566.466-1.032 1.032-1.032.566 0 1.031.466 1.032 1.032 0 .566-.466 1.032-1.032 1.032zm.889 6.51h-1.78V6.498h1.78v5.727zM13.11 2H2.885A.88.88 0 002 2.866v10.268a.88.88 0 00.885.866h10.226a.882.882 0 00.889-.866V2.865a.88.88 0 00-.889-.864z"/></svg>
        </a>
        <a href={MEDIUM_URL} target="_blank" rel="noopener noreferrer" class="cta-social-link" aria-label="Medium">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.846 6.887c.03-.295-.083-.586-.303-.784l-2.24-2.7v-.403h6.958l5.378 11.795 4.728-11.795h6.633v.403l-1.916 1.837c-.165.126-.247.333-.213.538v13.498c-.034.204.048.411.213.537l1.871 1.837v.403h-9.412v-.403l1.939-1.882c.19-.19.19-.246.19-.537v-10.91l-5.389 13.688h-.728l-6.275-13.688v9.174c-.052.385.076.774.347 1.052l2.521 3.058v.404h-7.148v-.404l2.521-3.058c.27-.279.39-.67.325-1.052v-10.608z"/></svg>
        </a>
      </nav>

      <p class="footer-copyright">
        &copy; {new Date().getFullYear()} Jose Roberto Vargas Orellana
        &mdash; Made with ❤️ , ☕ (x 8) and Astro
      </p>
    </div>
  </div>
</section>

<!-- Form success detection script -->
<script is:inline>
  (function() {
    var params = new URLSearchParams(window.location.search);
    if (params.get('submitted') === '1') {
      var banner = document.querySelector('.form-success');
      if (banner) banner.removeAttribute('hidden');
      var form = document.querySelector('.contact-form');
      if (form) form.style.display = 'none';
      history.replaceState({}, '', window.location.pathname + window.location.hash);
    }
  })();
</script>

<script>
  import { defineModule } from '../utils/lifecycle';
  import { gsap, ScrollTrigger } from '../utils/gsap-config';
  import { prefersReducedMotion } from '../utils/reduced-motion';

  defineModule('contact', () => {
    const triggers: ScrollTrigger[] = [];
    let pendingPreloaderCleanup: (() => void) | null = null;

    function initAnimations() {
      if (prefersReducedMotion()) {
        gsap.set(
          ['.cta-title', '.cta-desc', '.contact-form'],
          { opacity: 1, y: 0, scale: 1 },
        );
        return;
      }

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: '#contact',
          start: 'top 72%',
          once: true,
        },
      });

      if (tl.scrollTrigger) triggers.push(tl.scrollTrigger);

      tl.fromTo(
        '.cta-title',
        { opacity: 0, y: 30 },
        { opacity: 1, y: 0, duration: 0.7 },
      )
        .fromTo(
          '.cta-desc',
          { opacity: 0, y: 20 },
          { opacity: 1, y: 0, duration: 0.6 },
          '-=0.35',
        )
        .fromTo(
          '.contact-form',
          { opacity: 0, y: 20 },
          {
            opacity: 1,
            y: 0,
            duration: 0.5,
          },
          '-=0.15',
        );
    }

    if ((window as any).__portfolioLoaderDone) {
      initAnimations();
    } else {
      const handler = () => initAnimations();
      window.addEventListener('preloader:done', handler, { once: true });
      pendingPreloaderCleanup = () => window.removeEventListener('preloader:done', handler);
    }

    return () => {
      triggers.forEach((st) => st.kill());
      triggers.length = 0;
      pendingPreloaderCleanup?.();
      pendingPreloaderCleanup = null;
    };
  });
</script>

<style>
  .contact-section {
    padding-bottom: 4rem;
  }

  .contact-container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* ── CTA Card ── */
  .cta-card {
    width: 100%;
    max-width: 100%;
    padding: 1.75rem 1.25rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
  }

  .cta-icon {
    font-size: 2rem;
    line-height: 1;
    display: block;
  }

  .cta-title {
    font-family: var(--font-mono);
    font-size: var(--fs-headline-lg);
    font-weight: 700;
    color: var(--primary);
    line-height: 1.15;
    opacity: 1;
  }

  .cta-desc {
    font-family: var(--font-body);
    font-size: var(--fs-body-lg);
    color: var(--muted);
    line-height: 1.6;
    max-width: 480px;
    opacity: 1;
  }

  /* ── Contact Form ── */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    max-width: 100%;
    margin: 0.5rem auto 0;
    text-align: left;
    opacity: 1;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .form-field label {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 600;
    color: var(--text);
    letter-spacing: 0.04em;
  }

  .required-mark {
    color: var(--primary-container);
    margin-left: 0.15em;
  }

  .form-field input,
  .form-field textarea {
    font-family: var(--font-body);
    font-size: var(--fs-body-md);
    color: var(--text);
    background: var(--surface-container-low);
    border: 1px solid var(--outline-variant);
    border-radius: var(--radius-md);
    padding: 0.55rem 0.75rem;
    min-height: 44px;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    width: 100%;
    resize: vertical;
  }

  .form-field textarea {
    font-family: var(--font-mono);
    line-height: 1.5;
  }

  /* ── Token-derived cyan glow focus ring ── */
  .form-field input:focus,
  .form-field textarea:focus {
    outline: none;
    border-color: var(--primary-container);
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--primary-container) 15%, transparent),
      0 0 20px color-mix(in srgb, var(--primary-container) 8%, transparent);
  }

  /* ── Label hover/focus-within character-color effect ── */
  .form-field:hover label,
  .form-field:focus-within label {
    color: var(--primary-container);
    text-shadow: 0 0 8px color-mix(in srgb, var(--primary-container) 20%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .form-field:hover label,
    .form-field:focus-within label {
      text-shadow: none;
    }
  }

  .form-field input::placeholder,
  .form-field textarea::placeholder {
    color: var(--muted);
    opacity: 0.8;
  }

  .form-privacy {
    font-family: var(--font-body);
    font-size: var(--fs-code);
    color: var(--muted);
    margin: 0;
    line-height: 1.5;
  }

  .contact-submit {
    align-self: flex-start;
    margin-top: 0.25rem;
    padding: 0.65rem 1.25rem;
    min-height: 44px;
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }

  .form-success {
    font-family: var(--font-mono);
    color: var(--primary-container);
    font-size: var(--fs-body-md);
    margin-top: 1rem;
    text-align: center;
  }

  /* Light theme form overrides */
  [data-theme="light"] .form-field input,
  [data-theme="light"] .form-field textarea {
    background: #ffffff;
    border-color: var(--outline-variant);
    color: var(--text);
  }

  [data-theme="light"] .form-field input:focus,
  [data-theme="light"] .form-field textarea:focus {
    border-color: var(--primary-container);
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--primary-container) 18%, transparent),
      0 0 16px color-mix(in srgb, var(--primary-container) 10%, transparent);
  }

  /* ── Social Links (inside CTA card) ── */
  .cta-socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .cta-social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    color: var(--primary-container);
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .cta-social-link:hover {
    background: rgba(0, 242, 255, 0.1);
    color: var(--primary);
  }

  [data-theme="light"] .cta-social-link:hover {
    background: rgba(14, 116, 144, 0.08);
  }

  .cta-social-link:focus-visible {
    outline: 2px solid var(--primary-container);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .cta-social-link svg {
    width: 22px;
    height: 22px;
  }

  .footer-copyright {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--muted);
    line-height: 1.5;
    margin-top: 0.5rem;
  }

  /* ── Responsive ── */
  @media (min-width: 720px) {
    .cta-card {
      max-width: 560px;
      padding: 3rem 2rem;
      gap: 1.25rem;
    }

    .cta-icon {
      font-size: 2.5rem;
    }

    .cta-title {
      font-size: var(--fs-display);
    }

    .contact-form {
      max-width: 440px;
      gap: 0.85rem;
    }

    .form-field {
      gap: 0.3rem;
    }

    .form-field input,
    .form-field textarea {
      padding: 0.6rem 0.85rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-title,
    .cta-desc,
    .contact-form {
      opacity: 1;
    }
  }
</style>
