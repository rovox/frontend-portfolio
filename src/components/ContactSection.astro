---
import { FORMSPREE_ENDPOINT, GITHUB_URL, LINKEDIN_URL, MEDIUM_URL } from '../config';
---

<section id="contact" class="section contact-section">
  <div class="container contact-container">
    <!-- CTA Glass Card -->
    <div class="cta-card glass-card">
      <span class="cta-icon" aria-hidden="true">🚀</span>

      <h2 class="cta-title">Let's Work Together</h2>

      <p class="cta-desc">
        Currently accepting technical consultations
        and select freelance opportunities.
      </p>

      <!-- Formspree contact form -->
      <form
        class="contact-form"
        action={FORMSPREE_ENDPOINT}
        method="POST"
      >
        <div class="form-field">
          <label for="contact-name">Name</label>
          <input type="text" id="contact-name" name="name" autocomplete="name" />
        </div>

        <div class="form-field">
          <label for="contact-email">
            Email <span class="required-mark" aria-hidden="true">*</span>
          </label>
          <input
            type="email"
            id="contact-email"
            name="email"
            required
            autocomplete="email"
            aria-required="true"
          />
        </div>

        <div class="form-field">
          <label for="contact-message">
            Message <span class="required-mark" aria-hidden="true">*</span>
          </label>
          <textarea
            id="contact-message"
            name="message"
            required
            rows="4"
            aria-required="true"
          ></textarea>
        </div>

        <!-- Honeypot -->
        <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
        <input type="hidden" name="_next" value="/?submitted=1#contact" />

        <p class="form-privacy">
          Your data is sent securely via Formspree. No tracking, no analytics.
        </p>

        <button type="submit" class="btn btn-primary contact-submit">
          Send message
        </button>
      </form>

      <p class="form-success" hidden>
        ✓ Message sent. I'll get back to you soon.
      </p>

      <!-- Social Links inside CTA card -->
      <nav class="cta-socials" aria-label="Social links">
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="cta-social-link" aria-label="GitHub">
          <img src="/icons/github-svgrepo-com.svg" alt="" width="24" height="24" />
        </a>
        <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" class="cta-social-link" aria-label="LinkedIn">
          <img src="/icons/linkedin-1-svgrepo-com.svg" alt="" width="24" height="24" />
        </a>
        <a href={MEDIUM_URL} target="_blank" rel="noopener noreferrer" class="cta-social-link" aria-label="Medium">
          <img src="/icons/medium-svgrepo-com.svg" alt="" width="24" height="24" />
        </a>
      </nav>

      <p class="footer-copyright">
        &copy; {new Date().getFullYear()} Jose Roberto Vargas Orellana
        &mdash; Made with ❤️ , ☕ (x 8) and Astro
      </p>
    </div>
  </div>
</section>

<!-- Form success detection script -->
<script is:inline>
  (function() {
    var params = new URLSearchParams(window.location.search);
    if (params.get('submitted') === '1') {
      var banner = document.querySelector('.form-success');
      if (banner) banner.removeAttribute('hidden');
      var form = document.querySelector('.contact-form');
      if (form) form.style.display = 'none';
      history.replaceState({}, '', window.location.pathname + window.location.hash);
    }
  })();
</script>

<script>
  import { defineModule } from '../utils/lifecycle';
  import { gsap, ScrollTrigger } from '../utils/gsap-config';
  import { prefersReducedMotion } from '../utils/reduced-motion';

  defineModule('contact', () => {
    const triggers: ScrollTrigger[] = [];
    let pendingPreloaderCleanup: (() => void) | null = null;

    function initAnimations() {
      if (prefersReducedMotion()) {
        gsap.set(
          ['.cta-title', '.cta-desc', '.contact-form'],
          { opacity: 1, y: 0, scale: 1 },
        );
        return;
      }

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: '#contact',
          start: 'top 72%',
          once: true,
        },
      });

      if (tl.scrollTrigger) triggers.push(tl.scrollTrigger);

      tl.fromTo(
        '.cta-title',
        { opacity: 0, y: 30 },
        { opacity: 1, y: 0, duration: 0.7 },
      )
        .fromTo(
          '.cta-desc',
          { opacity: 0, y: 20 },
          { opacity: 1, y: 0, duration: 0.6 },
          '-=0.35',
        )
        .fromTo(
          '.contact-form',
          { opacity: 0, y: 20 },
          {
            opacity: 1,
            y: 0,
            duration: 0.5,
          },
          '-=0.15',
        );
    }

    if ((window as any).__portfolioLoaderDone) {
      initAnimations();
    } else {
      const handler = () => initAnimations();
      window.addEventListener('preloader:done', handler, { once: true });
      pendingPreloaderCleanup = () => window.removeEventListener('preloader:done', handler);
    }

    return () => {
      triggers.forEach((st) => st.kill());
      triggers.length = 0;
      pendingPreloaderCleanup?.();
      pendingPreloaderCleanup = null;
    };
  });
</script>

<style>
  .contact-section {
    padding-bottom: 4rem;
  }

  .contact-container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* ── CTA Card ── */
  .cta-card {
    width: 100%;
    max-width: 100%;
    padding: 1.75rem 1.25rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
  }

  .cta-icon {
    font-size: 2rem;
    line-height: 1;
    display: block;
  }

  .cta-title {
    font-family: var(--font-mono);
    font-size: var(--fs-headline-lg);
    font-weight: 700;
    color: var(--primary);
    line-height: 1.15;
    opacity: 1;
  }

  .cta-desc {
    font-family: var(--font-body);
    font-size: var(--fs-body-lg);
    color: var(--muted);
    line-height: 1.6;
    max-width: 480px;
    opacity: 1;
  }

  /* ── Contact Form ── */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    max-width: 100%;
    margin: 0.5rem auto 0;
    text-align: left;
    opacity: 1;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .form-field label {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 600;
    color: var(--text);
    letter-spacing: 0.04em;
  }

  .required-mark {
    color: var(--primary-container);
    margin-left: 0.15em;
  }

  .form-field input,
  .form-field textarea {
    font-family: var(--font-body);
    font-size: var(--fs-body-md);
    color: var(--text);
    background: var(--surface-container-low);
    border: 1px solid var(--outline-variant);
    border-radius: var(--radius-md);
    padding: 0.55rem 0.75rem;
    min-height: 44px;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    width: 100%;
    resize: vertical;
  }

  .form-field textarea {
    font-family: var(--font-mono);
    line-height: 1.5;
  }

  /* ── Token-derived cyan glow focus ring ── */
  .form-field input:focus,
  .form-field textarea:focus {
    outline: none;
    border-color: var(--primary-container);
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--primary-container) 15%, transparent),
      0 0 20px color-mix(in srgb, var(--primary-container) 8%, transparent);
  }

  /* ── Label hover/focus-within character-color effect ── */
  .form-field:hover label,
  .form-field:focus-within label {
    color: var(--primary-container);
    text-shadow: 0 0 8px color-mix(in srgb, var(--primary-container) 20%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .form-field:hover label,
    .form-field:focus-within label {
      text-shadow: none;
    }
  }

  .form-field input::placeholder,
  .form-field textarea::placeholder {
    color: var(--muted);
    opacity: 0.7;
  }

  .form-privacy {
    font-family: var(--font-body);
    font-size: var(--fs-code);
    color: var(--muted);
    margin: 0;
    line-height: 1.5;
  }

  .contact-submit {
    align-self: flex-start;
    margin-top: 0.25rem;
    padding: 0.65rem 1.25rem;
    min-height: 44px;
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }

  .form-success {
    font-family: var(--font-mono);
    color: var(--primary-container);
    font-size: var(--fs-body-md);
    margin-top: 1rem;
    text-align: center;
  }

  /* Light theme form overrides */
  [data-theme="light"] .form-field input,
  [data-theme="light"] .form-field textarea {
    background: #ffffff;
    border-color: var(--outline-variant);
    color: var(--text);
  }

  [data-theme="light"] .form-field input:focus,
  [data-theme="light"] .form-field textarea:focus {
    border-color: var(--primary-container);
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--primary-container) 18%, transparent),
      0 0 16px color-mix(in srgb, var(--primary-container) 10%, transparent);
  }

  /* ── Social Links (inside CTA card) ── */
  .cta-socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .cta-social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    transition: background var(--transition-fast);
  }

  .cta-social-link:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  [data-theme="light"] .cta-social-link:hover {
    background: rgba(14, 116, 144, 0.08);
  }

  .cta-social-link:focus-visible {
    outline: 2px solid var(--primary-container);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .cta-social-link img {
    width: 22px;
    height: 22px;
    transition: filter 0.2s ease, opacity 0.2s ease;
  }

  [data-theme="dark"] .cta-social-link img {
    filter: invert(1);
  }

  [data-theme="dark"] .cta-social-link:hover img {
    filter: invert(1) brightness(1.2);
  }

  [data-theme="light"] .cta-social-link img {
    filter: none;
  }

  [data-theme="light"] .cta-social-link:hover img {
    filter: brightness(0.6);
  }

  .footer-copyright {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: color-mix(in srgb, var(--muted) 50%, transparent);
    line-height: 1.5;
    margin-top: 0.5rem;
  }

  /* ── Responsive ── */
  @media (min-width: 720px) {
    .cta-card {
      max-width: 560px;
      padding: 3rem 2rem;
      gap: 1.25rem;
    }

    .cta-icon {
      font-size: 2.5rem;
    }

    .cta-title {
      font-size: var(--fs-display);
    }

    .contact-form {
      max-width: 440px;
      gap: 0.85rem;
    }

    .form-field {
      gap: 0.3rem;
    }

    .form-field input,
    .form-field textarea {
      padding: 0.6rem 0.85rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-title,
    .cta-desc,
    .contact-form {
      opacity: 1;
    }
  }
</style>
