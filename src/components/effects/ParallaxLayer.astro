---
interface Props {
  speed?: number;
  class?: string;
}

const { speed = -0.5, class: className = '' } = Astro.props;
---

<div class:list={['parallax-layer', className]} data-parallax-speed={speed}>
  <slot />
</div>

<script>
  import { defineModule } from '../../utils/lifecycle';
  import { gsap, ScrollTrigger } from '../../utils/gsap-config';
  import { prefersReducedMotion } from '../../utils/reduced-motion';

  defineModule('parallax', () => {
    if (prefersReducedMotion()) return;

    const layers = document.querySelectorAll<HTMLElement>('.parallax-layer');
    const triggers: ScrollTrigger[] = [];
    let pendingPreloaderCleanup: (() => void) | null = null;

    function initParallax() {
      layers.forEach((layer) => {
        const s = parseFloat(layer.dataset.parallaxSpeed || '-0.5');

        const tween = gsap.to(layer, {
          y: () => window.innerHeight * s,
          ease: 'none',
          scrollTrigger: {
            trigger: layer,
            start: 'top top',
            end: 'bottom top',
            scrub: true,
            invalidateOnRefresh: true,
          },
        });
        if (tween.scrollTrigger) triggers.push(tween.scrollTrigger);
      });

      ScrollTrigger.refresh();
    }

    if ((window as any).__portfolioLoaderDone) {
      initParallax();
    } else {
      const handler = () => initParallax();
      window.addEventListener('preloader:done', handler, { once: true });
      pendingPreloaderCleanup = () =>
        window.removeEventListener('preloader:done', handler);
    }

    return () => {
      triggers.forEach((t) => t.kill());
      triggers.length = 0;
      pendingPreloaderCleanup?.();
      pendingPreloaderCleanup = null;
    };
  });
</script>

<style>
  .parallax-layer {
    will-change: transform;
    position: relative;
  }
  @media (prefers-reduced-motion: reduce) {
    .parallax-layer {
      will-change: auto;
    }
  }
</style>
