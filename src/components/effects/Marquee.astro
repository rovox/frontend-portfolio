---
interface Props {
  items: string[];
  reverse?: boolean;
  label: string;
}
const { items, reverse = false, label } = Astro.props;
---

<div class="marquee" data-marquee={reverse ? 'reverse' : 'forward'} role="group" aria-label={label}>
  <ul class="marquee-track">
    {items.map((item) => <li class="marquee-item">{item}</li>)}
    {items.map((item) => <li class="marquee-item" aria-hidden="true">{item}</li>)}
  </ul>
</div>

<style>
  .marquee {
    overflow: hidden;
    padding-block: 1.1rem;
    border-block: 1px solid var(--border);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .marquee + .marquee { border-top: 0; }
  .marquee-track {
    display: flex;
    width: max-content;
    gap: 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    will-change: transform;
  }
  .marquee-item {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    line-height: 1;
    color: var(--muted);
    white-space: nowrap;
    transition: color var(--transition-fast);
  }
  .marquee-item::after {
    content: '✦';
    margin-left: 2.5rem;
    color: var(--primary-container);
    font-size: 0.6em;
    vertical-align: middle;
  }
  .marquee-item:hover { color: var(--primary-container); }

  /* Without JS motion the list simply wraps-scrolls horizontally. */
  @media (prefers-reduced-motion: reduce) {
    .marquee { overflow-x: auto; }
  }
</style>
