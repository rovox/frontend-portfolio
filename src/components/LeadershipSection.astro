---
import { render, type CollectionEntry } from 'astro:content';
import Carousel from './ui/Carousel.astro';

interface Props {
  items: CollectionEntry<'leadership'>[];
}

const { items } = Astro.props;
const rendered = await Promise.all(
  items.map(async (item) => {
    const { Content } = await render(item);
    return { ...item, Content };
  })
);
---

<section class="section" id="leadership">
  <div class="container">
    <h2 class="section-title">&lt;Leadership /&gt;</h2>
    <p class="section-note">// Community engagement and institutional service</p>

    <Carousel id="leadership" cardSelector=".leadership-item">
      {rendered.map((item) => (
        <article class="leadership-item glass-card card-glow">
          <h3 class="role">{item.data.role}</h3>
          <div class="meta">
            <span class="org">{item.data.organization}</span>
            <span class="year-pill">{item.data.year}</span>
          </div>
          <div class="desc">
            <item.Content />
          </div>
        </article>
      ))}
    </Carousel>
  </div>
</section>

<script>
import { defineModule } from '../utils/lifecycle';
import { gsap, ScrollTrigger } from '../utils/gsap-config';
import { prefersReducedMotion } from '../utils/reduced-motion';

  defineModule('leadership', () => {
    const triggers: ScrollTrigger[] = [];

    function init() {
      if (prefersReducedMotion()) {
        gsap.set('#leadership .carousel-root', { opacity: 1, y: 0 });
        return;
      }

      const tween = gsap.fromTo(
        '#leadership .carousel-root',
        { opacity: 0, y: 30 },
        {
          opacity: 1,
          y: 0,
          duration: 0.7,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: '#leadership',
            start: 'top 70%',
            once: true,
          },
        },
      );
      if (tween.scrollTrigger) triggers.push(tween.scrollTrigger);
    }

    if ((window as any).__portfolioLoaderDone) {
      init();
    } else {
      const handler = () => {
        init();
        requestAnimationFrame(() => ScrollTrigger.refresh());
      };
      window.addEventListener('preloader:done', handler, { once: true });
    }

    return () => {
      triggers.forEach((t) => t.kill());
      triggers.length = 0;
    };
  });
</script>

<style>
  .leadership-item {
    padding: 1.25rem;
    opacity: 1;
  }

  .role {
    margin: 0 0 0.4rem;
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: var(--fs-headline-md);
    font-weight: 600;
  }

  .meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .org {
    color: var(--muted);
    font-family: var(--font-accent);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .year-pill {
    flex-shrink: 0;
    padding: 0.2rem 0.55rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .desc {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-body);
    font-size: var(--fs-body-md);
    line-height: 1.6;
  }

  .desc :global(p) {
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
