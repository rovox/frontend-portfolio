---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  disabled?: boolean;
  type?: 'button' | 'submit';
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  disabled = false,
  type = 'button',
  class: className = '',
} = Astro.props;

const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['btn-ui', `btn-${variant}`, `btn-${size}`, className]}
  href={href}
  type={!href ? type : undefined}
  disabled={disabled}
  {...(href?.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
  <slot />
</Tag>

<style>
  .btn-ui {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-weight: 600;
    font-family: var(--font-mono);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    cursor: pointer;
    text-decoration: none;
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast), background var(--transition-fast), color var(--transition-fast);
  }

  .btn-ui:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .btn-ui:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  .btn-sm {
    padding: 0.45rem 0.75rem;
    font-size: 0.82rem;
    border-radius: var(--radius-sm);
  }

  .btn-md {
    padding: 0.7rem 1.1rem;
    font-size: 0.9rem;
  }

  .btn-lg {
    padding: 0.85rem 1.4rem;
    font-size: 1rem;
  }

  .btn-primary {
    background: var(--surface);
    color: var(--text);
  }

  .btn-primary:hover:not(:disabled) {
    transform: translateY(-1px);
    border-color: rgba(45, 226, 230, 0.7);
    box-shadow: var(--shadow-lg);
  }

  .btn-secondary {
    background: rgba(45, 226, 230, 0.1);
    color: var(--primary);
    border-color: rgba(45, 226, 230, 0.3);
  }

  .btn-secondary:hover:not(:disabled) {
    background: rgba(45, 226, 230, 0.2);
    border-color: var(--primary);
    box-shadow: var(--shadow-md);
  }

  .btn-ghost {
    background: transparent;
    color: var(--muted);
    border-color: transparent;
  }

  .btn-ghost:hover:not(:disabled) {
    color: var(--text);
    border-color: var(--border);
    background: var(--surface);
  }
</style>
