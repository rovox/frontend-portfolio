---
interface Props {
  id: string;
  title: string;
  note?: string;
  class?: string;
}

const { id, title, note, class: className = '' } = Astro.props;
---

<section class:list={['section', className]} id={id}>
  <div class="container">
    <h2 class="section-title">{title}</h2>
    {note && <p class="section-note">{note}</p>}
    <slot />
  </div>
</section>
