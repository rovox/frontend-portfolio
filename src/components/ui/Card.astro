---
interface Props {
  as?: 'article' | 'div';
  glow?: boolean;
  class?: string;
}

const {
  as: Tag = 'div',
  glow = false,
  class: className = '',
} = Astro.props;
---

<Tag class:list={['card-ui', { 'card-glow': glow }, className]}>
  <slot />
</Tag>

<style>
  .card-ui {
    padding: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition: border-color var(--transition-normal), background var(--transition-normal), transform var(--transition-fast);
  }

  .card-glow:hover {
    border-color: var(--primary-container);
    background: rgba(21, 29, 30, 0.85);
    transform: translateY(-2px);
  }

  [data-theme="light"] .card-glow:hover {
    background: #ffffff;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  }
</style>
