---
// 3-scene splash: "El Código Que Respira"
// Scene 1: The Cube (0-3s), Scene 2: Terminal (3-6s), Scene 3: Big Bang (6-7s)
// Total duration: ~7 seconds
// FSM: NOT_STARTED → RUNNING → COMPLETED | SKIPPED | FAILED
---

<div id="splash-container" class="splash-container" role="status" aria-label="Loading">

  <!-- SCENE 1: The Cube (0-3s) -->
  <div id="scene-1" class="scene" aria-hidden="true">
    <div class="cube">
      <div class="face front"></div>
      <div class="face back"></div>
      <div class="face right"></div>
      <div class="face left"></div>
      <div class="face top"></div>
      <div class="face bottom"></div>
    </div>
  </div>

  <!-- SCENE 2: PowerShell Terminal (3-6s) -->
  <div id="scene-2" class="scene terminal-scene" aria-hidden="true">
    <div class="terminal-window">
      <div class="terminal-line">
        <span class="terminal-prompt">PS C:\></span>
        <span class="terminal-typed" data-text="Software Engineer"></span>
        <span class="terminal-cursor">_</span>
      </div>
      <div class="terminal-line">
        <span class="terminal-prompt">PS C:\></span>
        <span class="terminal-typed" data-text="Data Science Student"></span>
        <span class="terminal-cursor">_</span>
      </div>
      <div class="terminal-line terminal-loading">
        <span class="terminal-prompt">PS C:\></span>
        <span class="loading-text">loading</span>
        <span class="loading-dots">
          <span>.</span><span>.</span><span>.</span>
        </span>
      </div>
    </div>
  </div>

  <!-- SCENE 3: Big Bang (6-7s) -->
  <div id="scene-3" class="scene" aria-hidden="true">
    <div id="big-bang-orb" class="big-bang-orb"></div>
  </div>

  <!-- Skip button -->
  <button id="skip-splash" class="skip-splash">SKIP</button>
</div>

<style is:global>
  /* --- Container + Scene Base --- */
  .splash-container {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #000;
    overflow: hidden;
    font-family: var(--font-mono);
    cursor: crosshair;
    display: none;
  }

  .scene {
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: 0;
  }

  /* Hide main content only while splash is active */
  body.splash-active #main-content {
    visibility: hidden;
  }

  body.splash-active {
    padding-top: 0;
  }

  /* --- SCENE 1: The Cube (CSS 3D) --- */
  #scene-1 {
    display: grid;
    place-items: center;
    perspective: 800px;
  }

  .cube {
    width: clamp(100px, 30vw, 200px);
    height: clamp(100px, 30vw, 200px);
    position: relative;
    transform-style: preserve-3d;
  }

  .face {
    position: absolute;
    width: clamp(100px, 30vw, 200px);
    height: clamp(100px, 30vw, 200px);
    border: clamp(2px, 0.5vw, 4px) solid #fff;
    background: transparent;
    box-shadow: 0 0 20px rgba(255, 255, 255, 0.35), inset 0 0 20px rgba(255, 255, 255, 0.12);
  }

  .front  { transform: translateZ(calc(clamp(100px, 30vw, 200px) / 2)); }
  .back   { transform: rotateY(180deg) translateZ(calc(clamp(100px, 30vw, 200px) / 2)); }
  .right  { transform: rotateY(90deg) translateZ(calc(clamp(100px, 30vw, 200px) / 2)); }
  .left   { transform: rotateY(-90deg) translateZ(calc(clamp(100px, 30vw, 200px) / 2)); }
  .top    { transform: rotateX(90deg) translateZ(calc(clamp(100px, 30vw, 200px) / 2)); }
  .bottom { transform: rotateX(-90deg) translateZ(calc(clamp(100px, 30vw, 200px) / 2)); }

  /* --- SCENE 2: PowerShell Terminal --- */
  #scene-2 {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #00007F;
  }

  .terminal-window {
    font-family: var(--font-mono);
    color: #F5F5F5;
    font-size: clamp(1.4rem, 4vw, 2.8rem);
    line-height: 1.6;
    padding: 2rem;
    min-width: min(90vw, 700px);
    text-shadow: 0 0 8px rgba(245, 245, 245, 0.3);
  }

  .terminal-line {
    display: flex;
    align-items: baseline;
    white-space: nowrap;
    opacity: 0;
  }

  .terminal-prompt {
    color: #00FFFF;
    margin-right: 0.6rem;
    flex-shrink: 0;
  }

  .terminal-typed {
    min-height: 1em;
  }

  .terminal-cursor {
    display: inline-block;
    color: #F5F5F5;
    margin-left: 0.1rem;
    animation: blinkCursor 0.8s step-end infinite;
  }

  .terminal-loading {
    margin-top: 1rem;
    gap: 0.3rem;
  }

  .loading-text {
    color: #F5F5F5;
  }

  .loading-dots span {
    display: inline-block;
    color: #00FFFF;
    animation: bounceDot 0.6s ease-in-out infinite alternate;
  }

  .loading-dots span:nth-child(2) { animation-delay: 0.15s; }
  .loading-dots span:nth-child(3) { animation-delay: 0.3s; }

  @keyframes blinkCursor {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  @keyframes bounceDot {
    0% { transform: translateY(0); opacity: 1; }
    100% { transform: translateY(-8px); opacity: 0.4; }
  }

  /* --- SCENE 3: Big Bang --- */
  #scene-3 {
    display: grid;
    place-items: center;
    opacity: 0;
  }

  .big-bang-orb {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 20px #fff, 0 0 60px #fff, 0 0 120px #fff;
    transform: scale(0);
  }

  /* --- Skip Button --- */
  .skip-splash {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 10001;
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.4);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    cursor: pointer;
    opacity: 0;
    padding: 0.5rem;
    transition: color 0.2s ease;
  }

  .skip-splash:hover { color: #fff; }

  .skip-splash:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
    color: #fff;
    opacity: 1;
  }
</style>

<script>
  // @ts-nocheck
  import { gsap } from '../utils/gsap-config';
  import { logLifecycle, mark, measure, fail } from '../utils/debug';

  (function () {
    var MOD = 'splash';

    // ── FSM ──
    var State = { NOT_STARTED: 'NOT_STARTED', RUNNING: 'RUNNING', COMPLETED: 'COMPLETED', SKIPPED: 'SKIPPED', FAILED: 'FAILED' };
    var state = State.NOT_STARTED;
    function transition(to) {
      if (state === to) return;
      var from = state;
      state = to;
      mark('splash:' + to);
      measure('splash:' + from + '->' + to, 'splash:' + from, 'splash:' + to);
      logLifecycle(MOD, from + ' -> ' + to);
    }

    // ── Cleanup registry: every listener/timer/tween registered here ──
    var cleanups = [];
    function onCleanup(fn) { cleanups.push(fn); }
    function runCleanups() {
      for (var i = cleanups.length - 1; i >= 0; i--) {
        try { cleanups[i](); } catch (e) { /* keep cleaning */ }
      }
      cleanups.length = 0;
    }

    function listen(target, type, fn, opts) {
      target.addEventListener(type, fn, opts);
      onCleanup(function () { target.removeEventListener(type, fn, opts); });
    }

    // ── Typewriter click sound (WebAudio, spec B2) ──
    var _clickCtx = null, _clickGain = null;
    function typewriterClick() {
      try {
        if (!_clickCtx) {
          var AC = window.AudioContext || window.webkitAudioContext;
          if (!AC) return;
          _clickCtx = new AC();
          _clickGain = _clickCtx.createGain();
          _clickGain.gain.value = 0.06;
          _clickGain.connect(_clickCtx.destination);
        }
        if (_clickCtx.state === 'suspended') return; // resumes on first gesture
        var now = _clickCtx.currentTime;
        var osc = _clickCtx.createOscillator();
        osc.type = 'square';
        osc.frequency.value = 1800 + Math.random() * 800;
        var env = _clickCtx.createGain();
        env.gain.setValueAtTime(0.08, now);
        env.gain.exponentialRampToValueAtTime(0.001, now + 0.03);
        osc.connect(env); env.connect(_clickGain);
        osc.start(now); osc.stop(now + 0.035);
      } catch (e) { /* audio is non-critical */ }
    }
    function closeClickCtx() {
      if (_clickCtx) { try { _clickCtx.close(); } catch (e) {} _clickCtx = null; _clickGain = null; }
    }
    function resumeClickCtx() { if (_clickCtx && _clickCtx.state === 'suspended') _clickCtx.resume(); }

    // ── finish(): single exit path — idempotent ──
    var finished = false;
    function finish(finalState) {
      if (finished) return;
      finished = true;
      transition(finalState);
      mark('splash:cleanup');
      runCleanups();       // removes scroll-lock, listeners, watchdog, kills timeline
      closeClickCtx();
      var main = document.getElementById('main-content');
      if (main) main.style.visibility = 'visible';
      window.__portfolioLoaderDone = true;
      window.dispatchEvent(new CustomEvent('preloader:done'));
      logLifecycle(MOD, 'preloader:done dispatched');
      var container = document.getElementById('splash-container');
      if (container) container.remove();
      document.body.classList.remove('splash-active');
      measure('splash:total', 'splash:RUNNING');
      logLifecycle(MOD, 'cleanup complete');
    }

    // ── WCAG 2.3.3 exception ──
    // Splash is a deliberate artistic/branding element, not a functional animation.
    // Users bypass via Skip button (visible, focusable) or Escape key.
    // Reduced-motion is respected everywhere else in the site.
    logLifecycle(MOD, 'splash always shows — WCAG exception');

    // ── Always run the splash (no sessionStorage guard, no reduced-motion skip) ──
    transition(State.RUNNING);
    mark('splash:RUNNING');
    var container = document.getElementById('splash-container');
    if (!container) { fail(MOD, 'splash-container not found'); finish(State.FAILED); return; }
    container.style.display = 'block';
    document.body.classList.add('splash-active');
    logLifecycle(MOD, 'splash container visible');

    // Scroll lock (symmetric — unlocked via cleanup registry)
    var scrollY = window.scrollY;
    document.documentElement.style.overflow = 'hidden';
    document.body.style.overflow = 'hidden';
    document.body.style.position = 'fixed';
    document.body.style.top = -scrollY + 'px';
    document.body.style.width = '100%';
    function preventScroll(e) { e.preventDefault(); e.stopPropagation(); return false; }
    function blockKeys(e) {
      var keys = ['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', ' ', 'Home', 'End'];
      if (keys.indexOf(e.key) !== -1) e.preventDefault();
    }
    listen(window, 'wheel', preventScroll, { passive: false });
    listen(window, 'touchmove', preventScroll, { passive: false });
    listen(window, 'keydown', blockKeys);
    onCleanup(function () {
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.width = '';
      window.scrollTo(0, scrollY);
    });

    // AudioContext resume on first gesture
    listen(window, 'pointerdown', resumeClickCtx);
    listen(window, 'keydown', resumeClickCtx);

    // Watchdog — ALWAYS guarantees cleanup (spec J)
    var watchdog = setTimeout(function () { finish(State.FAILED); }, 12000);
    onCleanup(function () { clearTimeout(watchdog); });

    // Master timeline — killed via cleanup registry
    var master = gsap.timeline();
    onCleanup(function () { master.kill(); });

    // ── Scene 1: The Cube (0-3s) ──
    function createScene1Timeline() {
      var tl = gsap.timeline();
      tl.set('#scene-1', { opacity: 1 }, 0);
      // 3D rotation
      tl.to(
        '.cube',
        {
          rotateY: 360,
          rotateX: -20,
          duration: 3,
          ease: 'none',
        },
        0
      );
      // Border color white -> cyan
      tl.to(
        '.face',
        {
          borderColor: '#00f2ff',
          duration: 1.5,
          ease: 'power2.inOut',
        },
        0.5
      );
      // Disassemble: each face flies outward
      tl.to('.front', { x: 150, y: -100, opacity: 0, duration: 0.5, ease: 'power3.in' }, 2.5);
      tl.to('.back', { x: -150, y: -80, opacity: 0, duration: 0.5, ease: 'power3.in' }, 2.55);
      tl.to('.right', { x: 180, y: 50, opacity: 0, duration: 0.5, ease: 'power3.in' }, 2.6);
      tl.to('.left', { x: -160, y: 60, opacity: 0, duration: 0.5, ease: 'power3.in' }, 2.65);
      tl.to('.top', { x: 20, y: -200, opacity: 0, duration: 0.5, ease: 'power3.in' }, 2.7);
      tl.to('.bottom', { x: -30, y: 180, opacity: 0, duration: 0.5, ease: 'power3.in' }, 2.75);
      tl.set('#scene-1', { opacity: 0 }, 2.8);
      // Reset for potential replay
      tl.set('.face', { x: 0, y: 0, opacity: 1, borderColor: '#fff' }, 2.8);
      return tl;
    }

    // ── Scene 2: PowerShell Terminal (3-6s) — single-tween typewriter + click sound ──
    function typeTextTimeline(element, text, duration) {
      var tl = gsap.timeline();
      element.textContent = '';
      var state = { progress: 0, last: 0 };
      tl.to(state, {
        progress: text.length,
        duration: duration,
        ease: 'none',
        onUpdate: function () {
          var idx = Math.floor(state.progress);
          if (idx !== state.last) {
            element.textContent = text.substring(0, idx);
            for (var k = state.last; k < idx; k++) typewriterClick();
            state.last = idx;
          }
        },
      });
      return tl;
    }

    function createScene2Timeline() {
      var tl = gsap.timeline();
      tl.set('#scene-2', { opacity: 1 }, 0);

      var line1 = document.querySelector('#scene-2 .terminal-line:nth-child(1) .terminal-typed');
      var line2 = document.querySelector('#scene-2 .terminal-line:nth-child(2) .terminal-typed');

      // Line 1: "Software Engineer"
      tl.set('#scene-2 .terminal-line:nth-child(1)', { opacity: 1 }, 0);
      tl.add(typeTextTimeline(line1, 'Software Engineer', 0.8), 0);

      // Line 2: "Data Science Student"
      tl.set('#scene-2 .terminal-line:nth-child(2)', { opacity: 1 }, 1.0);
      tl.add(typeTextTimeline(line2, 'Data Science Student', 0.8), 1.0);

      // Cursor blink animation
      tl.to(
        '.terminal-cursor',
        { opacity: 0, duration: 0.4, repeat: -1, yoyo: true, ease: 'steps(1)' },
        0
      );

      // Loading dots
      tl.to(
        '.loading-dots span',
        { y: -8, opacity: 0.4, duration: 0.3, stagger: 0.1, repeat: -1, yoyo: true, ease: 'power1.inOut' },
        2.0
      );

      tl.set('#scene-2 .terminal-loading', { opacity: 1 }, 2.0);
      tl.set('#scene-2', { opacity: 0 }, 2.5);
      return tl;
    }

    // ── Scene 3: Big Bang (6-7s) ──
    function createScene3Timeline() {
      var tl = gsap.timeline({
        onComplete: function () {
          finish(State.COMPLETED);
        },
      });

      // Show scene 2 briefly, then shrink it
      tl.set('#scene-2', { opacity: 1, scale: 1 }, 0);
      tl.to('#scene-2', { scale: 0, opacity: 0, duration: 0.4, ease: 'power3.in' }, 0);

      // Big bang orb explodes
      tl.set('#scene-3', { opacity: 1 }, 1.0);
      tl.to('#big-bang-orb', { scale: 300, duration: 0.5, ease: 'expo.in' }, 1.0);
      tl.to('#big-bang-orb', { opacity: 0, duration: 0.3 }, 1.5);

      return tl;
    }

    // ── Skip Button ──
    function skip() { finish(State.SKIPPED); }
    var skipBtn = document.getElementById('skip-splash');
    if (skipBtn) {
      listen(skipBtn, 'click', skip);
      // Register skip button fade-in in master timeline
      master.to(skipBtn, { opacity: 1, duration: 0.5 }, 1.5);
    }
    listen(document, 'keydown', function (e) { if (e.key === 'Escape') skip(); });

    // ── Build Master Timeline ──
    master.add(createScene1Timeline(), 0);
    master.add(createScene2Timeline(), 3);
    master.add(createScene3Timeline(), 6);

    // Background color transitions
    master.set('.splash-container', { backgroundColor: '#0a0f1e' }, 0);
    master.to('.splash-container', { backgroundColor: '#00007F', duration: 0.5, ease: 'none' }, 3);
    master.to('.splash-container', { backgroundColor: '#ffffff', duration: 0.15, ease: 'power3.in' }, 6.5);
    master.to('.splash-container', { backgroundColor: '#0d1515', duration: 0.25, ease: 'power3.out' }, 6.8);

    master.play();
  })();
</script>
