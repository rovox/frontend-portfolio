---
import Layout from '../layouts/Layout.astro';

const pageTitle = "About Me";
const identity = {
  firstName: "Jose Roberto",
  lastName: "Vargas Orellana",
  country: "Bolivia",
  city: "Cochabamba",
  occupation: "Software Developer, Data Scientist, Full Stack Web/Mobile/Desktop",
};

const skills = ["Python", "React", "TypeScript", "SQL", "ML/AI"];
---

<Layout title={pageTitle}>
	<main class="about-container">
		<h1>{pageTitle}</h1>
		<h2 class="about-subtitle">Software Developer &amp; Data Scientist</h2>

		<p>
			I'm {identity.firstName} {identity.lastName}, a {identity.occupation} based in {identity.city}, {identity.country}.
			I build immersive digital experiences across web, mobile, and desktop platforms — combining
			strong engineering fundamentals with a deep eye for UI/UX design.
		</p>

		<p>
			My work spans full-stack development, data science, and creative coding. I'm passionate about
			building tools and interfaces that are both performant and beautiful.
		</p>

		<div class="about-grid">
			<div class="about-card">
				<h3>Location</h3>
				<p>{identity.city}, {identity.country}</p>
			</div>
			<div class="about-card">
				<h3>Focus</h3>
				<p>Full Stack · Data Science · UI/UX</p>
			</div>
			<div class="about-card">
				<h3>Platforms</h3>
				<p>Web · Mobile · Desktop</p>
			</div>
		</div>

		<h3 class="skills-heading">Core Technologies</h3>
		<ul class="skills-list">
			{skills.map((skill) => <li>{skill}</li>)}
		</ul>
	</main>
</Layout>

<style>
	.about-container {
		max-width: 1120px;
		margin: 0 auto;
		padding: 8rem 1.25rem;
		min-height: 100vh;
	}

	h1 {
		font-size: clamp(2rem, 5vw, 3rem);
		margin-bottom: 0.5rem;
		font-family: var(--font-mono);
	}

	.about-subtitle {
		font-size: clamp(1.1rem, 3vw, 1.5rem);
		color: var(--muted);
		margin-bottom: 2rem;
		font-family: var(--font-mono);
		font-weight: 400;
	}

	p {
		font-size: 1rem;
		line-height: 1.7;
		margin-bottom: 1.5rem;
		color: var(--text);
	}

	.about-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1rem;
		margin: 2rem 0;
	}

	.about-card {
		padding: 1.25rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		transition: border-color var(--transition-normal), box-shadow var(--transition-normal);
	}

	.about-card:hover {
		border-color: rgba(45, 226, 230, 0.4);
		box-shadow: var(--shadow-sm);
	}

	.about-card h3 {
		margin: 0 0 0.5rem;
		color: var(--primary);
		font-family: var(--font-mono);
		font-size: 0.9rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.about-card p {
		margin: 0;
		color: var(--muted);
		font-size: 0.95rem;
	}

	.skills-heading {
		font-family: var(--font-mono);
		font-size: 1rem;
		color: var(--primary);
		margin: 2rem 0 1rem;
	}

	.skills-list {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding: 0;
	}

	.skills-list li {
		padding: 0.45rem 0.85rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		font-family: var(--font-mono);
		font-size: 0.88rem;
		color: var(--muted);
		background: var(--surface);
		transition: border-color var(--transition-fast), color var(--transition-fast);
	}

	.skills-list li:hover {
		border-color: var(--primary);
		color: var(--primary);
	}
</style>
