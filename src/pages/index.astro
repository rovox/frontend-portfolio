---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import SkillsSection from '../components/SkillsSection.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import EducationSection from '../components/EducationSection.astro';
import LeadershipSection from '../components/LeadershipSection.astro';
/* import LatestPosts from '../components/LatestPosts.astro'; */  // Blog disabled — see specs/bugfix-a11y-splash-round1.md
import ContactSection from '../components/ContactSection.astro';
import AtAGlance from '../components/AtAGlance.astro';
import { summary } from '../data/summary';
import { SITE_URL } from '../config';
import Marquee from '../components/effects/Marquee.astro';
import LazyTideEffect from '../components/Hero3D/LazyTideEffect.tsx';
// ParallaxLayer removed from hero — the transformed wrapper breaks
// GSAP position:fixed pinning used by the terminal journey.

// --- Content Collections ---
const skills = await getCollection('skills');
skills.sort((a, b) => a.data.order - b.data.order);

const experiences = await getCollection('experiences');
experiences.sort((a, b) => a.data.order - b.data.order);

const projects = await getCollection('projects');
projects.sort((a, b) => a.data.order - b.data.order);

const education = await getCollection('education');
education.sort((a, b) => a.data.order - b.data.order);

const leadership = await getCollection('leadership');
leadership.sort((a, b) => a.data.order - b.data.order);

const techs = [...new Set([...projects, ...experiences].flatMap((e) => e.data.technologies))];
const half = Math.ceil(techs.length / 2);
const stats = [
  { value: experiences.length, suffix: '+', label: 'Roles & experiences' },
  { value: projects.length, suffix: '+', label: 'Projects shipped' },
  { value: techs.length, suffix: '+', label: 'Technologies used' },
  { value: leadership.length, label: 'Leadership roles' },
];
---

<Layout
  title={`${summary.name} | ${summary.role} Portfolio`}
  description={summary.short}
  jsonLd={projects.map((p) => ({
    '@type': 'CreativeWork',
    name: p.data.title,
    description: p.data.description,
    keywords: p.data.technologies.join(', '),
    author: { '@id': `${SITE_URL}/#person` },
    ...(p.data.liveUrl ? { url: p.data.liveUrl } : {}),
  }))}
>
  <LazyTideEffect client:only="react" />
  <HeroSection />
  <ExperienceSection items={experiences} />
  <ProjectsSection items={projects} />
  <Marquee items={techs.slice(0, half)} label="Technologies I work with" />
  <Marquee items={techs.slice(half)} reverse label="More technologies I work with" />
  <SkillsSection items={skills} />
  <EducationSection items={education} />
  <LeadershipSection items={leadership} />
  <AtAGlance stats={stats} />
  <!-- <LatestPosts /> -->
  <ContactSection />
</Layout>
