---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import SkillsSection from '../components/SkillsSection.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import EducationSection from '../components/EducationSection.astro';
import LeadershipSection from '../components/LeadershipSection.astro';
/* import LatestPosts from '../components/LatestPosts.astro'; */  // Blog disabled — see specs/bugfix-a11y-splash-round1.md
import ContactSection from '../components/ContactSection.astro';
import LazyTideEffect from '../components/Hero3D/LazyTideEffect.tsx';
// ParallaxLayer removed from hero — the transformed wrapper breaks
// GSAP position:fixed pinning used by the terminal journey.

// --- Content Collections ---
const skills = await getCollection('skills');
skills.sort((a, b) => a.data.order - b.data.order);

const experiences = await getCollection('experiences');
experiences.sort((a, b) => a.data.order - b.data.order);

const projects = await getCollection('projects');
projects.sort((a, b) => a.data.order - b.data.order);

const education = await getCollection('education');
education.sort((a, b) => a.data.order - b.data.order);

const leadership = await getCollection('leadership');
leadership.sort((a, b) => a.data.order - b.data.order);

// --- Social Links ---
const socialLinks = [
  { label: 'GitHub', href: 'https://github.com/rovox' },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/jroberto-vargas-orellana/',
  },
  { label: 'WhatsApp', href: 'https://wa.me/59162642144' },
  { label: 'Gmail', href: 'mailto:varor.joseroberto@gmail.com' },
];
---

<Layout title="Jose Roberto Vargas Orellana | Portfolio">
  <LazyTideEffect client:only="react" />
  <HeroSection />
  <SkillsSection items={skills} />
  <ExperienceSection items={experiences} />
  <ProjectsSection items={projects} />
  <EducationSection items={education} />
  <LeadershipSection items={leadership} />
  <!-- <LatestPosts /> -->
  <ContactSection socialLinks={socialLinks} />
</Layout>
