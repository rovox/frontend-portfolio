---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Card from '../components/ui/Card.astro';
import Tag from '../components/ui/Tag.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Blog">
	<main class="blog-container">
		<h1>Blog</h1>
		<p class="blog-subtitle">Thoughts on engineering, data science, and creative coding.</p>
		<div class="blog-grid">
			{posts.map((post) => {
        const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
        });
        return (
          <a href={`/blogs/${post.id}/`} class="blog-link">
            <Card as="article" glow>
              <h2>{post.data.title}</h2>
              <div class="post-meta">
                <time datetime={post.data.pubDate.toISOString().split('T')[0]}>{formattedDate}</time>
              </div>
              <p class="post-desc">{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <div class="post-tags">
                  {post.data.tags.map((tag) => (
                    <Tag variant="primary">{tag}</Tag>
                  ))}
                </div>
              )}
            </Card>
          </a>
        );
      })}
		</div>
	</main>
</Layout>

<style>
	.blog-container {
		max-width: 1120px;
		margin: 0 auto;
		padding: 8rem 1.25rem;
		min-height: 100vh;
	}

	h1 {
		font-size: clamp(2rem, 5vw, 3rem);
		margin-bottom: 0.5rem;
		font-family: var(--font-mono);
	}

	.blog-subtitle {
		font-size: 1rem;
		line-height: 1.6;
		margin-bottom: 2.5rem;
		color: var(--muted);
	}

	.blog-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.25rem;
	}

	.blog-link {
		text-decoration: none;
		color: inherit;
		display: block;
	}

	.blog-link :global(.card-ui) {
		transition: border-color var(--transition-normal), box-shadow var(--transition-normal), transform var(--transition-fast);
	}

	.blog-link:hover :global(.card-ui) {
		border-color: rgba(45, 226, 230, 0.7);
		box-shadow: var(--shadow-lg);
		transform: translateY(-2px);
	}

	.blog-link h2 {
		font-size: 1.3rem;
		font-family: var(--font-mono);
		margin-bottom: 0.5rem;
	}

	.post-meta {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--muted);
		margin-bottom: 0.75rem;
	}

	.post-desc {
		color: var(--muted);
		font-size: 0.95rem;
		line-height: 1.6;
		margin-bottom: 0.75rem;
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}

	@media (min-width: 720px) {
		.blog-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
